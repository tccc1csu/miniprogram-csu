@startuml
title 数据库关系图 — 采编审核及归档依据
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 13
skinparam shadowing false
skinparam backgroundColor white
skinparam linetype ortho
skinparam nodesep 65
skinparam ranksep 85
skinparam entityBackgroundColor #F5FAFF
skinparam entityBorderColor #46637F
skinparam ArrowColor #334155
hide circle
entity "同步审核结论\neditorial_review" as editorial_review {
  editorial_review_id : INTEGER <<PK, NN>>
  --
  outcome_id : INTEGER <<FK, UQ, NN>>
  reviewer_id : INTEGER <<FK, NN>>
  decision : TEXT <<NN>>
  opinion : TEXT <<NN>>
  reviewed_at : TEXT <<NN>>
}
entity "同步审核稿件依据\neditorial_review_item" as editorial_review_item {
  editorial_review_id : INTEGER <<PK, FK, NN>>
  review_id : INTEGER <<PK, FK, NN>>
}
entity "采编归档完成\neditorial_archive" as editorial_archive {
  editorial_id : INTEGER <<PK, FK, NN>>
  --
  editorial_review_id : INTEGER <<FK, UQ, NN>>
  archived_at : TEXT <<NN>>
}
entity "采编协同\neditorial" as editorial {
  editorial_id : INTEGER <<PK, NN>>
}
entity "稿件审查结论\nmanuscript_review" as manuscript_review {
  review_id : INTEGER <<PK, NN>>
}
entity "成员与账号\nmember" as member {
  member_id : INTEGER <<PK, NN>>
}
entity "成果提交\noutcome" as outcome {
  outcome_id : INTEGER <<PK, NN>>
}
member ||--o{ editorial_review
outcome ||--o| editorial_review
manuscript_review ||--o{ editorial_review_item
editorial_review ||--o{ editorial_review_item
editorial_review ||--o| editorial_archive
editorial ||--o| editorial_archive
legend bottom
  PK 主键；FK 外键；UQ 单列唯一；NN 非空；NULL 可空。
  || 恰一；|o 零或一；o{ 零到多。复合唯一约束见数据字典。
  图为分视图，外部上下文表只显示主键；同名表为同一张表。
  连线为正交折线；具体外键字段及关联角色以数据字典为准。
endlegend
@enduml
