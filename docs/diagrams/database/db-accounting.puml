@startuml
title 数据库关系图 — 贡献依据、计量与规则
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 13
skinparam shadowing false
skinparam backgroundColor white
skinparam linetype ortho
skinparam nodesep 65
skinparam ranksep 85
skinparam entityBackgroundColor #F5FAFF
skinparam entityBorderColor #46637F
skinparam ArrowColor #334155
hide circle
entity "贡献类型\ncontribution_type" as contribution_type {
  type_id : INTEGER <<PK, NN>>
  --
  code : TEXT <<UQ, NN>>
  name : TEXT <<UQ, NN>>
}
entity "部门津贴标准版本\nallowance_standard" as allowance_standard {
  standard_id : INTEGER <<PK, NN>>
  --
  department_id : INTEGER <<FK, NN>>
  version_no : INTEGER <<NN>>
  effective_from : TEXT <<NN>>
  hourly_rate_cents : INTEGER <<NN>>
}
entity "贡献计量规则\ncontribution_policy" as contribution_policy {
  policy_id : INTEGER <<PK, NN>>
  --
  standard_id : INTEGER <<FK, NN>>
  type_id : INTEGER <<FK, NN>>
  basis_rule : TEXT <<NN>>
  urgent_applies : INTEGER <<NN>>
}
entity "工作贡献依据\ncontribution_basis" as contribution_basis {
  basis_id : INTEGER <<PK, NN>>
  --
  source_id : INTEGER <<FK, NN>>
  type_id : INTEGER <<FK, NN>>
  member_id : INTEGER <<FK, NN>>
  department_id : INTEGER <<FK, NN>>
  occurred_at : TEXT <<NN>>
  evidence : TEXT <<NN>>
}
entity "阶段贡献引用\nstage_contribution" as stage_contribution {
  stage_id : INTEGER <<PK, FK, NN>>
  basis_id : INTEGER <<PK, FK, NN>>
}
entity "已核实贡献计量\ncontribution_measurement" as contribution_measurement {
  basis_id : INTEGER <<PK, FK, NN>>
  --
  policy_id : INTEGER <<FK, NN>>
  base_hours_u : INTEGER <<NN>>
  assessed_at : TEXT <<NN>>
}
entity "唯一业务来源\nbusiness_source" as business_source {
  source_id : INTEGER <<PK, NN>>
}
entity "部门\ndepartment" as department {
  department_id : INTEGER <<PK, NN>>
}
entity "成员与账号\nmember" as member {
  member_id : INTEGER <<PK, NN>>
}
entity "任务阶段\ntask_stage" as task_stage {
  stage_id : INTEGER <<PK, NN>>
}
department ||--o{ allowance_standard
contribution_type ||--o{ contribution_policy
allowance_standard ||--o{ contribution_policy
department ||--o{ contribution_basis
member ||--o{ contribution_basis
contribution_type ||--o{ contribution_basis
business_source ||--o{ contribution_basis
contribution_basis ||--o{ stage_contribution
task_stage ||--o{ stage_contribution
contribution_policy ||--o{ contribution_measurement
contribution_basis ||--o| contribution_measurement
legend bottom
  PK 主键；FK 外键；UQ 单列唯一；NN 非空；NULL 可空。
  || 恰一；|o 零或一；o{ 零到多。复合唯一约束见数据字典。
  图为分视图，外部上下文表只显示主键；同名表为同一张表。
  连线为正交折线；具体外键字段及关联角色以数据字典为准。
endlegend
@enduml
