@startuml
skinparam defaultFontName Microsoft YaHei
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #466482
skinparam classAttributeIconSize 0
hide empty members
title D 数据层：工时与结算
left to right direction
entity "任务\ntasks" as tasks {
  * id : text <<PK>>
  * number : text
  * title : text
  * creator_id : text <<FK>>
  * department_id : text <<FK>>
  layout_type : text
  deadline : timestamp with time zone
  * notes : text
  * open_registration : boolean
  * urgent : boolean
  * created_at : timestamp with time zone
  * kind : text
  linked_task_id : text <<FK>>
  * config_version : integer <<FK>>
  reminder_hours : numeric(8,2)
  * report_note : text
}
entity "工时贡献\nworklogs" as worklogs {
  * id : text <<PK>>
  * task_id : text <<FK>>
  * user_id : text <<FK>>
  * department_id : text <<FK>>
  * kind : text
  * rule_name : text
  * base_units : integer
  * effective_units : integer
  * rate_cents : integer
  * confirmed : boolean
  * created_at : timestamp with time zone
  * source_key : text
  rule_id : integer <<FK>>
  * rule_version : integer <<FK>>
  * multiplier : integer
}
entity "核定审计\nadjustments" as adjustments {
  * id : text <<PK>>
  * log_id : text <<FK>>
  * old_units : integer
  * new_units : integer
  * reason : text
  * actor_id : text <<FK>>
  * created_at : timestamp with time zone
}
entity "个人报表视图\nsaved_views" as saved_views {
  * id : text <<PK>>
  * user_id : text <<FK>>
  * name : text
  * config : jsonb
}
entity "封存批次\nreport_seals" as report_seals {
  * id : text <<PK>>
  * name : text
  * created_by : text <<FK>>
  * start_date : date
  * end_date : date
  * created_at : timestamp with time zone
}
entity "封存行快照\nseal_rows" as seal_rows {
  * seal_id : text <<PK FK>>
  * source_id : text <<PK FK>>
  * data : jsonb
}
entity "账号\nusers" as users {
  * id : text <<PK>>
  * username : text
  * name : text
  * password_hash : text
  * role : text
  department_id : text <<FK>>
  * payable : boolean
  * active : boolean
}
adjustments --> users : (actor_id)
adjustments --> worklogs : (log_id)
report_seals --> users : (created_by)
saved_views --> users : (user_id)
seal_rows --> report_seals : (seal_id)
seal_rows --> worklogs : (source_id)
tasks --> users : (creator_id)
tasks --> tasks : (linked_task_id)
worklogs --> tasks : (task_id)
worklogs --> users : (user_id)
legend bottom
箭头为外键依赖（指向被引用表），不是流程。
* 非空；PK主键；FK外键。完整唯一与检查约束见数据字典。
跨分区外键未全部显示，完整外键表列出所有79项。
endlegend

@enduml
