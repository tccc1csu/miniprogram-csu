@startuml
skinparam defaultFontName Microsoft YaHei
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #466482
skinparam classAttributeIconSize 0
hide empty members
title D 当前关系数据库分区总览
left to right direction
package "组织身份" as g0 {
rectangle "departments" as t_departments
rectangle "users" as t_users
rectangle "sessions" as t_sessions
}
package "推文闭环" as g1 {
rectangle "tasks" as t_tasks
rectangle "task_reviewers" as t_task_reviewers
rectangle "assignments" as t_assignments
rectangle "versions" as t_versions
rectangle "reviews" as t_reviews
rectangle "publications" as t_publications
rectangle "archives" as t_archives
rectangle "publication_routing" as t_publication_routing
}
package "材料与批注" as g2 {
rectangle "files" as t_files
rectangle "version_files" as t_version_files
rectangle "version_annotations" as t_version_annotations
rectangle "registrations" as t_registrations
rectangle "registration_files" as t_registration_files
rectangle "file_payloads" as t_file_payloads
}
package "六部门任务" as g3 {
rectangle "jobs" as t_jobs
rectangle "bookings" as t_bookings
rectangle "article_lines" as t_article_lines
rectangle "work_entries" as t_work_entries
}
package "工时与结算" as g4 {
rectangle "worklogs" as t_worklogs
rectangle "adjustments" as t_adjustments
rectangle "saved_views" as t_saved_views
rectangle "report_seals" as t_report_seals
rectangle "seal_rows" as t_seal_rows
}
package "政策与默认值" as g5 {
rectangle "workflow_policy" as t_workflow_policy
rectangle "labor_rules" as t_labor_rules
rectangle "rule_revisions" as t_rule_revisions
rectangle "publication_defaults" as t_publication_defaults
rectangle "teacher_delivery" as t_teacher_delivery
rectangle "flow_defaults" as t_flow_defaults
}
package "轮转与通知" as g6 {
rectangle "duty_rotation" as t_duty_rotation
rectangle "duty_rotation_members" as t_duty_rotation_members
rectangle "duty_slots" as t_duty_slots
rectangle "reminders" as t_reminders
rectangle "outbox" as t_outbox
rectangle "events" as t_events
}
t_tasks --> t_users : 发起人
t_tasks --> t_workflow_policy : 规则版本
t_versions --> t_tasks
t_reviews --> t_versions
t_archives --> t_tasks
t_worklogs --> t_tasks
t_adjustments --> t_worklogs
t_seal_rows --> t_worklogs
t_files --> t_tasks
t_outbox --> t_tasks
legend bottom
38张业务表完整分区清单；这里只保留主干关系。
字段与79项外键见分区ER图及数据字典。
endlegend
@enduml
