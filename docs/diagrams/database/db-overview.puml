  basis_id : I64 [PK2; FK R081; NN]
  --
  PK(report_id, basis_id)
  R081 FK(basis_id)
    → contribution_measurement(basis_id)
  R082 FK(report_id)
    → weekly_report(report_id)
  --
  UQ(report_id,basis_id)
}
entity "周报待核对项\nreport_pending" as report_pending <<中心周报>> {
  report_id : I64 [PK1; FK R084; NN]
  basis_id : I64 [PK2; FK R083; NN]
  reason : TEXT [NN]
  --
  PK(report_id, basis_id)
  R083 FK(basis_id)
    → contribution_basis(basis_id)
  R084 FK(report_id)
    → weekly_report(report_id)
  --
  UQ(report_id,basis_id)
}
entity "周报封存\nreport_seal" as report_seal <<中心周报>> {
  report_id : I64 [PK1; FK R085; NN]
  --
  PK(report_id)
  R085 FK(report_id)
    → weekly_report(report_id)
}
