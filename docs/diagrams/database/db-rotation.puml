@startuml
skinparam defaultFontName Microsoft YaHei
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #466482
skinparam classAttributeIconSize 0
hide empty members
title D 数据层：轮转与通知
left to right direction
entity "任务\ntasks" as tasks {
  * id : text <<PK>>
  * number : text
  * title : text
  * creator_id : text <<FK>>
  * department_id : text <<FK>>
  layout_type : text
  deadline : timestamp with time zone
  * notes : text
  * open_registration : boolean
  * urgent : boolean
  * created_at : timestamp with time zone
  * kind : text
  linked_task_id : text <<FK>>
  * config_version : integer <<FK>>
  reminder_hours : numeric(8,2)
  * report_note : text
}
entity "承接安排\nassignments" as assignments {
  * task_id : text <<PK FK>>
  * assignee_id : text <<FK>>
  * actor_id : text <<FK>>
  * created_at : timestamp with time zone
  * automatic : boolean
}
entity "轮转指针\nduty_rotation" as duty_rotation {
  * department_id : text <<PK FK>>
  last_user_id : text <<FK>>
  * updated_by : text <<FK>>
}
entity "轮转成员\nduty_rotation_members" as duty_rotation_members {
  * department_id : text <<PK FK>>
  * user_id : text <<PK FK>>
  * position : integer
}
entity "历史时段表\nduty_slots" as duty_slots {
  * id : text <<PK>>
  department_id : text <<FK>>
  * user_id : text <<FK>>
  * start_at : timestamp with time zone
  * end_at : timestamp with time zone
  * created_by : text <<FK>>
}
entity "提醒去重\nreminders" as reminders {
  * task_id : text <<PK FK>>
  * kind : text <<PK>>
}
entity "通知发件箱\noutbox" as outbox {
  * id : text <<PK>>
  * task_id : text <<FK>>
  * event : text
  * recipient_id : text <<FK>>
  * payload : jsonb
  * status : text
  * created_at : timestamp with time zone
  * attempts : integer
  * next_attempt : timestamp with time zone
  last_error : text
}
entity "任务审计\nevents" as events {
  * id : text <<PK>>
  * task_id : text <<FK>>
  * actor_id : text <<FK>>
  * action : text
  * detail : text
  * created_at : timestamp with time zone
}
entity "账号\nusers" as users {
  * id : text <<PK>>
  * username : text
  * name : text
  * password_hash : text
  * role : text
  department_id : text <<FK>>
  * payable : boolean
  * active : boolean
}
assignments --> users : (actor_id)
assignments --> users : (assignee_id)
assignments --> tasks : (task_id)
duty_rotation --> users : (last_user_id)
duty_rotation --> users : (updated_by)
duty_rotation_members --> duty_rotation : (department_id)
duty_rotation_members --> users : (user_id)
duty_slots --> users : (created_by)
duty_slots --> users : (user_id)
events --> users : (actor_id)
events --> tasks : (task_id)
outbox --> users : (recipient_id)
outbox --> tasks : (task_id)
reminders --> tasks : (task_id)
tasks --> users : (creator_id)
tasks --> tasks : (linked_task_id)
legend bottom
箭头为外键依赖（指向被引用表），不是流程。
* 非空；PK主键；FK外键。完整唯一与检查约束见数据字典。
跨分区外键未全部显示，完整外键表列出所有79项。
endlegend

@enduml
