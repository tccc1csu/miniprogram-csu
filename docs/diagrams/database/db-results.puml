@startuml
title 数据库关系图 — 成果、发布与版本审核
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 13
skinparam shadowing false
skinparam backgroundColor white
skinparam linetype ortho
skinparam nodesep 65
skinparam ranksep 85
skinparam entityBackgroundColor #F5FAFF
skinparam entityBorderColor #46637F
skinparam ArrowColor #334155
hide circle
entity "成果提交\noutcome" as outcome {
  outcome_id : INTEGER <<PK, NN>>
  --
  source_id : INTEGER <<FK, NN>>
  submission_no : INTEGER <<NN>>
  submitted_by : INTEGER <<FK, NN>>
  completed_note : TEXT <<NN>>
  submitted_at : TEXT <<NN>>
}
entity "成果附件\noutcome_attachment" as outcome_attachment {
  attachment_id : INTEGER <<PK, NN>>
  --
  outcome_id : INTEGER <<FK, NN>>
  file_name : TEXT <<NN>>
  storage_ref : TEXT <<NN>>
}
entity "成果稿件版本\noutcome_version" as outcome_version {
  outcome_id : INTEGER <<PK, FK, NN>>
  version_id : INTEGER <<PK, FK, NN>>
}
entity "发布成果\npublication" as publication {
  publication_id : INTEGER <<PK, NN>>
  --
  outcome_id : INTEGER <<FK, NN>>
  version_id : INTEGER <<FK, NULL>>
  platform_id : INTEGER <<FK, NN>>
  result_url : TEXT <<NN>>
}
entity "阶段当前送审版\nstage_current_draft" as stage_current_draft {
  stage_id : INTEGER <<PK, FK, NN>>
  --
  outcome_id : INTEGER <<FK, NN>>
  version_id : INTEGER <<FK, NN>>
}
entity "稿件审查结论\nmanuscript_review" as manuscript_review {
  review_id : INTEGER <<PK, NN>>
  --
  version_id : INTEGER <<FK, NN>>
  level : INTEGER <<NN>>
  round_no : INTEGER <<NN>>
  reviewer_id : INTEGER <<FK, NN>>
  decision : TEXT <<NN>>
  opinion : TEXT <<NN>>
  reviewed_at : TEXT <<NN>>
  prior_review_id : INTEGER <<FK, NULL>>
}
entity "唯一业务来源\nbusiness_source" as business_source {
  source_id : INTEGER <<PK, NN>>
}
entity "稿件版本\nmanuscript_version" as manuscript_version {
  version_id : INTEGER <<PK, NN>>
}
entity "成员与账号\nmember" as member {
  member_id : INTEGER <<PK, NN>>
}
entity "发布平台\nplatform" as platform {
  platform_id : INTEGER <<PK, NN>>
}
entity "任务阶段\ntask_stage" as task_stage {
  stage_id : INTEGER <<PK, NN>>
}
member ||--o{ outcome
business_source ||--o{ outcome
outcome ||--o{ outcome_attachment
manuscript_version ||--o{ outcome_version
outcome ||--o{ outcome_version
outcome_version |o--o{ publication
platform ||--o{ publication
outcome ||--o{ publication
outcome_version ||--o{ stage_current_draft
task_stage ||--o| stage_current_draft
manuscript_review |o--o{ manuscript_review
member ||--o{ manuscript_review
manuscript_version ||--o{ manuscript_review
legend bottom
  PK 主键；FK 外键；UQ 单列唯一；NN 非空；NULL 可空。
  || 恰一；|o 零或一；o{ 零到多。复合唯一约束见数据字典。
  图为分视图，外部上下文表只显示主键；同名表为同一张表。
  连线为正交折线；具体外键字段及关联角色以数据字典为准。
endlegend
@enduml
