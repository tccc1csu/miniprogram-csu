@startuml
skinparam defaultFontName Microsoft YaHei
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #466482
skinparam classAttributeIconSize 0
hide empty members
title D 数据层：材料与批注
left to right direction
entity "任务\ntasks" as tasks {
  * id : text <<PK>>
  * number : text
  * title : text
  * creator_id : text <<FK>>
  * department_id : text <<FK>>
  layout_type : text
  deadline : timestamp with time zone
  * notes : text
  * open_registration : boolean
  * urgent : boolean
  * created_at : timestamp with time zone
  * kind : text
  linked_task_id : text <<FK>>
  * config_version : integer <<FK>>
  reminder_hours : numeric(8,2)
  * report_note : text
}
entity "稿件版本\nversions" as versions {
  * id : text <<PK>>
  * task_id : text <<FK>>
  * number : integer
  * body : text
  * preview_url : text
  * author_id : text <<FK>>
  * created_at : timestamp with time zone
  * phase : text
  * preview_html : text
}
entity "附件元数据\nfiles" as files {
  * id : text <<PK>>
  * task_id : text <<FK>>
  * owner_id : text <<FK>>
  * storage_name : text
  * name : text
  * size : integer
  * sha256 : text
  * created_at : timestamp with time zone
}
entity "版本附件\nversion_files" as version_files {
  * version_id : text <<PK FK>>
  * file_id : text <<PK FK>>
}
entity "选区批注\nversion_annotations" as version_annotations {
  * id : text <<PK>>
  * task_id : text <<FK>>
  * version_id : text <<FK>>
  * stage : text
  * actor_id : text <<FK>>
  * start_offset : integer
  * end_offset : integer
  * quote : text
  * body : text
  * created_at : timestamp with time zone
}
entity "公开报名\nregistrations" as registrations {
  * id : text <<PK>>
  * task_id : text <<FK>>
  * user_id : text <<FK>>
  * notes : text
  * created_at : timestamp with time zone
}
entity "报名附件\nregistration_files" as registration_files {
  * registration_id : text <<PK FK>>
  * file_id : text <<PK FK>>
}
entity "附件兼容载荷\nfile_payloads" as file_payloads {
  * file_id : text <<PK FK>>
  * content : bytea
}
file_payloads --> files : (file_id)
files --> tasks : (task_id)
registration_files --> files : (file_id)
registration_files --> registrations : (registration_id)
registrations --> tasks : (task_id)
tasks --> tasks : (linked_task_id)
version_annotations --> versions : (task_id, version_id)
version_files --> files : (file_id)
version_files --> versions : (version_id)
versions --> tasks : (task_id)
legend bottom
箭头为外键依赖（指向被引用表），不是流程。
* 非空；PK主键；FK外键。完整唯一与检查约束见数据字典。
跨分区外键未全部显示，完整外键表列出所有79项。
endlegend

@enduml
