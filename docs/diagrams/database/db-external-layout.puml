@startuml
title 数据库关系图 — 外部需求与公众号排版
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 13
skinparam shadowing false
skinparam backgroundColor white
skinparam linetype ortho
skinparam nodesep 65
skinparam ranksep 85
skinparam entityBackgroundColor #F5FAFF
skinparam entityBorderColor #46637F
skinparam ArrowColor #334155
hide circle
entity "外部需求\nexternal_request" as external_request {
  request_id : INTEGER <<PK, NN>>
  --
  requester_id : INTEGER <<FK, NN>>
  target_department_id : INTEGER <<FK, NN>>
  title : TEXT <<NN>>
  request_note : TEXT <<NN>>
  deadline_at : TEXT <<NULL>>
  submitted_at : TEXT <<NN>>
}
entity "外部需求承接责任\nexternal_request_assignment" as external_request_assignment {
  request_id : INTEGER <<PK, FK, NN>>
  --
  assignee_id : INTEGER <<FK, NN>>
  assigned_by : INTEGER <<FK, NN>>
  assigned_at : TEXT <<NN>>
}
entity "公众号排版任务\noperations_layout_task" as operations_layout_task {
  layout_task_id : INTEGER <<PK, NN>>
  --
  title : TEXT <<NN>>
  layout_kind : TEXT <<NN>>
  deadline_at : TEXT <<NN>>
  created_by : INTEGER <<FK, NN>>
  created_at : TEXT <<NN>>
}
entity "排版承接责任\noperations_layout_assignment" as operations_layout_assignment {
  layout_task_id : INTEGER <<PK, FK, NN>>
  --
  assignee_id : INTEGER <<FK, NN>>
  assigned_by : INTEGER <<FK, NN>>
  assigned_at : TEXT <<NN>>
}
entity "唯一业务来源\nbusiness_source" as business_source {
  source_id : INTEGER <<PK, NN>>
  --
  editorial_id : INTEGER <<FK, UQ, NULL>>
  booking_id : INTEGER <<FK, UQ, NULL>>
  stage_id : INTEGER <<FK, UQ, NULL>>
  external_request_id : INTEGER <<FK, UQ, NULL>>
  operations_layout_task_id : INTEGER <<FK, UQ, NULL>>
}
entity "业务来源附件\nsource_attachment" as source_attachment {
  attachment_id : INTEGER <<PK, NN>>
  --
  source_id : INTEGER <<FK, NN>>
  file_name : TEXT <<NN>>
  storage_ref : TEXT <<NN>>
  uploaded_by : INTEGER <<FK, NN>>
  uploaded_at : TEXT <<NN>>
}
entity "来源审核岗位安排\nsource_review_assignment" as source_review_assignment {
  source_id : INTEGER <<PK, FK, NN>>
  level : INTEGER <<PK, NN>>
  --
  reviewer_id : INTEGER <<FK, NN>>
  assigned_by : INTEGER <<FK, NN>>
  assigned_at : TEXT <<NN>>
}
entity "来源审核事件\nsource_review" as source_review {
  review_id : INTEGER <<PK, NN>>
  --
  source_id : INTEGER <<FK, NN>>
  outcome_id : INTEGER <<FK, NN>>
  level : INTEGER <<NN>>
  round_no : INTEGER <<NN>>
  reviewer_id : INTEGER <<FK, NN>>
  decision : TEXT <<NN>>
  opinion : TEXT <<NN>>
  reviewed_at : TEXT <<NN>>
  prior_review_id : INTEGER <<FK, NULL>>
}
entity "来源最终归档\nsource_archive" as source_archive {
  source_id : INTEGER <<PK, FK, NN>>
  --
  outcome_id : INTEGER <<FK, UQ, NN>>
  final_review_id : INTEGER <<FK, UQ, NN>>
  archived_by : INTEGER <<FK, NN>>
  archived_at : TEXT <<NN>>
}
entity "部门\ndepartment" as department {
  department_id : INTEGER <<PK, NN>>
}
entity "采编协同\neditorial" as editorial {
  editorial_id : INTEGER <<PK, NN>>
}
entity "成员与账号\nmember" as member {
  member_id : INTEGER <<PK, NN>>
}
entity "成果提交\noutcome" as outcome {
  outcome_id : INTEGER <<PK, NN>>
}
entity "摄制预约\nproduction_booking" as production_booking {
  booking_id : INTEGER <<PK, NN>>
}
entity "任务阶段\ntask_stage" as task_stage {
  stage_id : INTEGER <<PK, NN>>
}
department ||--o{ external_request
member ||--o{ external_request
member ||--o{ external_request_assignment
external_request ||--o| external_request_assignment
member ||--o{ operations_layout_task
member ||--o{ operations_layout_assignment
operations_layout_task ||--o| operations_layout_assignment
operations_layout_task |o--o| business_source
external_request |o--o| business_source
task_stage |o--o| business_source
production_booking |o--o| business_source
editorial |o--o| business_source
member ||--o{ source_attachment
business_source ||--o{ source_attachment
member ||--o{ source_review_assignment
business_source ||--o{ source_review_assignment
outcome ||--o{ source_review
source_review |o--o{ source_review
member ||--o{ source_review
business_source ||--o{ source_review
source_review ||--o{ source_archive
member ||--o{ source_archive
outcome ||--o| source_archive
business_source ||--o| source_archive
legend bottom
  PK 主键；FK 外键；UQ 单列唯一；NN 非空；NULL 可空。
  || 恰一；|o 零或一；o{ 零到多。复合唯一约束见数据字典。
  图为分视图，外部上下文表只显示主键；同名表为同一张表。
  连线为正交折线；具体外键字段及关联角色以数据字典为准。
endlegend
@enduml
