@startuml
title 数据库关系图 — 组织、账号与会话
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 13
skinparam shadowing false
skinparam backgroundColor white
skinparam linetype ortho
skinparam nodesep 65
skinparam ranksep 85
skinparam entityBackgroundColor #F5FAFF
skinparam entityBorderColor #46637F
skinparam ArrowColor #334155
hide circle
entity "中心组织\norganization" as organization {
  organization_id : INTEGER <<PK, NN>>
  --
  name : TEXT <<UQ, NN>>
}
entity "部门\ndepartment" as department {
  department_id : INTEGER <<PK, NN>>
  --
  organization_id : INTEGER <<FK, NN>>
  name : TEXT <<NN>>
  enabled : INTEGER <<NN>>
}
entity "成员与账号\nmember" as member {
  member_id : INTEGER <<PK, NN>>
  --
  name : TEXT <<NN>>
  login_name : TEXT <<UQ, NN>>
  password_hash : TEXT <<NULL>>
  account_role : TEXT <<NN>>
  department_id : INTEGER <<FK, NULL>>
  enabled : INTEGER <<NN>>
}
entity "外部身份绑定\nexternal_identity" as external_identity {
  identity_id : INTEGER <<PK, NN>>
  --
  member_id : INTEGER <<FK, NN>>
  provider : TEXT <<NN>>
  app_scope : TEXT <<NN>>
  subject : TEXT <<NN>>
}
entity "登录会话\nlogin_session" as login_session {
  session_id : INTEGER <<PK, NN>>
  --
  member_id : INTEGER <<FK, NN>>
  token_hash : TEXT <<UQ, NN>>
  issued_at : TEXT <<NN>>
  expires_at : TEXT <<NN>>
  terminated_at : TEXT <<NULL>>
}
entity "归档人偏好\narchive_preference" as archive_preference {
  production_member_id : INTEGER <<PK, FK, NN>>
  --
  office_member_id : INTEGER <<FK, NN>>
}
organization ||--o{ department
department |o--o{ member
member ||--o{ external_identity
member ||--o{ login_session
member ||--o{ archive_preference
member ||--o| archive_preference
legend bottom
  PK 主键；FK 外键；UQ 单列唯一；NN 非空；NULL 可空。
  || 恰一；|o 零或一；o{ 零到多。复合唯一约束见数据字典。
  图为分视图，外部上下文表只显示主键；同名表为同一张表。
  连线为正交折线；具体外键字段及关联角色以数据字典为准。
endlegend
@enduml
