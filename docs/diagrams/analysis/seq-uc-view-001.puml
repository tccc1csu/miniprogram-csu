@startuml
skinparam defaultFontName Microsoft YaHei
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #466482
skinparam classAttributeIconSize 0
hide empty members
title UC-VIEW-001 查看个人工作与工时的分析序列
actor "内部成员" as actor
boundary "网页与手机页面" as page
control "公共访问控制" as ctl
entity "账号与会话" as identity
entity "任务工作簿" as model
actor -> page : 提出个人查询
page -> ctl : 协调业务请求(UC-VIEW-001)
ctl -> identity : 验证访问资格(会话、业务职责)
identity --> ctl : 可信身份及可用范围
ctl -> model : 核验当前条件()
model --> ctl : 可办理结果或失败原因
note right of model
已登录
end note
alt 业务条件满足
ctl -> model : 查看个人工作与工时()
model -> model : 限定本人任务与计酬范围()
model -> model : 汇总个人工作和贡献()
model --> ctl : 业务结果及可用后续操作
ctl --> page : 处理回执
page --> actor : 展示处理结果
else 业务条件不满足
ctl --> page : 失败原因与可恢复条件
page --> actor : 保留输入并显示原因
end

@enduml
