@startuml
skinparam defaultFontName Microsoft YaHei
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #466482
skinparam classAttributeIconSize 0
hide empty members
skinparam defaultFontSize 14
skinparam sequenceLifeLineBorderColor #9AA8B8
skinparam sequenceArrowColor #334155
skinparam sequenceGroupBorderColor #94A3B8
skinparam sequenceGroupBackgroundColor #F8FAFC
skinparam sequenceParticipantPadding 18
skinparam maxMessageSize 240
hide footbox
autonumber
title UC-OL-006 确认运营内部审校 · 分析序列
actor "指定运营审校部长" as actor
boundary "业务页面" as page
control "推文控制" as ctl
entity "账号与会话" as identity
entity "推文协作簿" as model
actor -> page : 确认运营内部审校\n版本、结论、原因
activate page
page -> ctl : 协调业务请求(UC-OL-006)
activate ctl
ctl -> identity : 验证访问资格(会话、业务职责)
activate identity
identity --> ctl : 可信身份与可用范围
deactivate identity
ctl -> model : 核验当前条件(输入、身份)
activate model
model -> model : 核验两位指定岗位之一()
model --> ctl : 可办理结果／失败原因
deactivate model
alt 业务条件满足
ctl -> model : 确认运营内部审校()
activate model
model -> model : 仅记录实际审校人的结论()
model --> ctl : 业务结果与后续操作
deactivate model
ctl --> page : 成功回执
page --> actor : 展示结果
else 业务条件不满足
ctl --> page : 失败原因与可恢复条件
page --> actor : 保留输入并显示原因
end
deactivate ctl
deactivate page
legend bottom left
前置条件：
当前版本待内审，属于两位指定审校之一
成功事实：
内部审校事件与教师待办
审核退回须留原因；仅通过才开放下一环节。
endlegend

@enduml
