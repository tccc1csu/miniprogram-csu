@startuml
skinparam defaultFontName Microsoft YaHei
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #466482
skinparam classAttributeIconSize 0
hide empty members
skinparam defaultFontSize 14
skinparam sequenceLifeLineBorderColor #9AA8B8
skinparam sequenceArrowColor #334155
skinparam sequenceGroupBorderColor #94A3B8
skinparam sequenceGroupBackgroundColor #F8FAFC
skinparam sequenceParticipantPadding 18
skinparam maxMessageSize 240
hide footbox
autonumber
title UC-PR-001 提出摄制预约 · 分析序列
actor "摄制需求人" as actor
boundary "业务页面" as page
control "部门协作控制" as ctl
entity "账号与会话" as identity
entity "部门任务簿" as model
actor -> page : 提出摄制预约\n预约时间、地点、联系人、需求、备注
activate page
page -> ctl : 协调业务请求(UC-PR-001)
activate ctl
ctl -> identity : 验证访问资格(会话、业务职责)
activate identity
identity --> ctl : 可信身份与可用范围
deactivate identity
ctl -> model : 核验当前条件(输入、身份)
activate model
model -> model : 按预约窗口判定加急()
model --> ctl : 可办理结果／失败原因
deactivate model
alt 业务条件满足
ctl -> model : 提出摄制预约()
activate model
model -> model : 建立预约并开放承接()
model --> ctl : 业务结果与后续操作
deactivate model
ctl --> page : 成功回执
page --> actor : 展示结果
else 业务条件不满足
ctl --> page : 失败原因与可恢复条件
page --> actor : 保留输入并显示原因
end
deactivate ctl
deactivate page
legend bottom left
前置条件：
内部人员、外部组织或管理员有预约资格
成功事实：
摄制任务及预约资料
endlegend

@enduml
