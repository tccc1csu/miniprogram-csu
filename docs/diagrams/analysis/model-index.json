  "states": [
    {
      "slug": "state-editorial",
      "title": "分析状态机图（一）— 采编协同",
      "owner": "Editorial",
      "description": "状态属于一条采编协同。迁移前核验审核、材料和可用计量依据，迁移动作完成贡献归集与归档；已归档仍可查询，重复合法归档用内部响应表示。"
    },
    {
      "slug": "state-production",
      "title": "分析状态机图（二）— 摄制预约",
      "owner": "Booking",
      "description": "同一个确定承接事件按派发／抢单条件处理，未承接检查与建立承接关系作为一个对象责任。冲突拒绝发生在对象创建前。"
    },
    {
      "slug": "state-stage",
      "title": "分析状态机图（三）— 任务阶段（运营推文实例）",
      "owner": "Stage",
      "description": "以已明确审核岗位的运营推文阶段为例。状态由承接、稿件版本、审核结论、发布依据共同决定；退回后分清稿件修改与发布依据补正。"
    },
    {
      "slug": "state-stage-design",
      "title": "分析状态机图（四）— 任务阶段（美编设计实例）",
      "owner": "Stage",
      "description": "美编设计阶段直接交部长确认，不套用运营稿件的一审、二审；退回保留原责任人与历史成果。"
    },
    {
      "slug": "state-workflow",
      "title": "分析状态机图（五）— 流转任务",
      "owner": "Workflow",
      "description": "整体任务只在全部阶段完成后结束；规则或贡献依据缺失时保留待核对项，不把任务完成等同于津贴已核实。"
    },
    {
      "slug": "state-external-request",
      "title": "分析状态机图（六）— 外部需求",
      "owner": "ExternalRequest",
      "description": "外部需求由兄弟部门发布、目标部门部长派发，承接成员提交成果后由部长或管理员审核；归档不自动结算津贴。"
    },
    {
      "slug": "state-operations-layout",
      "title": "分析状态机图（七）— 公众号排版任务",
      "owner": "OperationsLayout",
      "description": "排版任务在派发时指定干事、一审和二审；按状态逐级审核，同一人承担两岗时一审通过直接归档并计量。"
    }
  ],
