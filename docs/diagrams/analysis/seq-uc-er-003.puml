@startuml
title UC-ER-003 提交外部需求成果 — 分析序列图
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #F5FAFF
skinparam classBorderColor #46637F
skinparam ArrowColor #334155
skinparam nodesep 35
skinparam ranksep 45
hide footbox
autonumber
skinparam sequenceMessageAlign center
skinparam sequenceGroupBackgroundColor white
actor "外部需求承接成员" as A
boundary "接口:普通成员接口" as B
control "控制:提交外部需求成果控制" as C
participant "M:成员" as M
participant "E:外部需求" as E
participant "O:成果" as O
A -> B: 提交外部需求成果(业务信息)
activate B
B -> C: 提交外部需求成果(业务信息)
activate C
C -> M: 验证业务资格(操作人、部门与职责)
M --> C: 资格结论
break 无权执行
  C --> B: 拒绝结果及原因
  B --> A: 拒绝结果及原因
end

C -> E: 提交成果(承接人、完成说明、链接、附件)
activate E
E -> O: 验证完整性(外部需求成果)
O --> E: 完整性结论
E --> C: 待审核结果或拒绝原因
deactivate E

C --> B: 业务结果或拒绝原因
deactivate C
B --> A: 业务结果或拒绝原因
deactivate B
@enduml
