@startuml
skinparam defaultFontName Microsoft YaHei
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #466482
skinparam classAttributeIconSize 0
hide empty members
title C 边界控制实体职责分配
top to bottom direction
class "网页与手机页面" as UI <<boundary>> {
收集完整业务信息()
展示处理回执()
}
class "身份控制" as C0 <<control>> {
协调业务请求()
传递可信身份与领域结果()
}
UI --> C0
class "公共访问控制" as C1 <<control>> {
协调业务请求()
传递可信身份与领域结果()
}
UI --> C1
class "推文控制" as C2 <<control>> {
协调业务请求()
传递可信身份与领域结果()
}
UI --> C2
class "部门协作控制" as C3 <<control>> {
协调业务请求()
传递可信身份与领域结果()
}
UI --> C3
class "结算控制" as C4 <<control>> {
协调业务请求()
传递可信身份与领域结果()
}
UI --> C4
class "账号与会话" as E0 <<entity>> {
核验当前条件()
登录工作台()
验证密码与启用状态()
建立有时限的可信会话()
退出工作台()
使当前会话失效()
验证访问资格()
}
class "任务工作簿" as E1 <<entity>> {
核验当前条件()
查看任务与办理进度()
限制可见任务范围()
汇集版本审核与归档事实()
查看个人工作与工时()
限定本人任务与计酬范围()
汇总个人工作和贡献()
维护任务报表备注()
核验任务相关身份()
更新备注并保留变更事件()
}
class "推文协作簿" as E2 <<entity>> {
核验当前条件()
提出推文任务()
验证来源与关联稿件()
建立任务及审核岗位路由()
提交或修订源稿()
验证本人材料归属()
追加源稿版本并保留历史()
审阅外部源稿内容()
验证当前源稿与采编资格()
记录内容审核及后续状态()
安排推文承接()
核验承接人资格()
保存安排及可选默认值()
提交排版版本()
验证本人承接与材料()
追加排版版本并重启审核链()
确认运营内部审校()
核验两位指定岗位之一()
仅记录实际审校人的结论()
完成教师一审()
核验指定一审老师与版本()
记录一审结论及后续状态()
完成教师二审()
核验不同的二审老师与版本()
记录二审结论及后续状态()
登记推文发布()
验证全部审核通过()
形成发布与正常归档事实()
报名公开征集()
核验窗口与本人材料()
拒绝重复并保存报名()
标注稿件意见()
核验当前阶段审阅资格()
比对UTF16选区并绑定版本()
}
class "部门任务簿" as E3 <<entity>> {
核验当前条件()
建立采编办公稿件任务()
核验稿件行与原创作者()
建立逐行任务并选择承接()
提出摄制预约()
按预约窗口判定加急()
建立预约并开放承接()
提出部门需求()
核验目标部门与规则()
建立部门需求及来源()
提出设计任务()
核验设计复杂度与规则()
建立设计任务()
安排部门任务()
校验本部门承接资格()
保存安排及可选默认值()
领取摄制任务()
检查未来预约尚未承接()
确定唯一当前承接人()
提交部门交付物()
检查内容与交付阶段()
保存版本并产生下一环节待办()
审阅采编内容()
核验指定内容老师与版本()
记录内容结论及后续状态()
验收并归档部门任务()
核验验收资格和交付版本()
形成正常验收与归档事实()
强制关闭异常任务()
验证管理范围与非空原因()
保留强制关闭且不计自动工时()
}
class "工时台账" as E4 <<entity>> {
核验当前条件()
登记例外工作量()
核验计酬资格与人工规则()
登记带来源的例外贡献()
核定特殊工时()
核验管理范围与核定原因()
追加调整审计并更新实时值()
筛选并导出工时报表()
限制人员日期与列配置()
按当前有效值形成报表()
封存结算报表()
验证全中心结算范围()
复制不可变封存行()
登记合格贡献()
}
class "承接与政策配置" as E5 <<entity>> {
核验当前条件()
配置教师与承接规则()
核验配置部门与教师互异()
保存后续任务默认配置()
维护工时规则版本()
核验可调规则与原因()
追加政策版本并保留旧值()
}
class "通知收件箱" as E6 <<entity>> {
核验当前条件()
查看任务通知()
限定当前收件人()
返回真实渠道状态与任务入口()
}
C0 --> E0
C1 --> E1
C1 --> E5
C1 --> E0
C1 --> E6
C2 --> E2
C2 --> E0
C3 --> E0
C3 --> E3
C4 --> E4
C4 --> E5
C4 --> E0
E2 --> E4 : 完成贡献
E3 --> E4 : 完成贡献
note bottom of E1
分析聚合持有业务事实并保护本身规则。
集合实体受理创建；单个任务在受理后建立。
控制协调路径，关系库与HTTP适配留在D章。
end note

@enduml
