@startuml
title UC-OL-003 提交公众号排版成果 — 分析序列图
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #F5FAFF
skinparam classBorderColor #46637F
skinparam ArrowColor #334155
skinparam nodesep 35
skinparam ranksep 45
hide footbox
autonumber
skinparam sequenceMessageAlign center
skinparam sequenceGroupBackgroundColor white
actor "排版干事" as A
boundary "接口:普通成员接口" as B
control "控制:提交公众号排版成果控制" as C
participant "M:成员" as M
participant "L:公众号排版任务" as L
participant "O:成果" as O
A -> B: 提交公众号排版成果(业务信息)
activate B
B -> C: 提交公众号排版成果(业务信息)
activate C
C -> M: 验证业务资格(操作人、部门与职责)
M --> C: 资格结论
break 无权执行
  C --> B: 拒绝结果及原因
  B --> A: 拒绝结果及原因
end

C -> L: 提交排版成果(排版干事、说明、链接、附件)
activate L
L -> O: 验证完整性(排版成果)
O --> L: 完整性结论
L --> C: 待一审结果或拒绝原因
deactivate L

C --> B: 业务结果或拒绝原因
deactivate C
B --> A: 业务结果或拒绝原因
deactivate B
@enduml
