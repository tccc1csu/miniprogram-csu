page{background:#F5F6FA;color:#263445;font:30rpx -apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif}view,text,input,textarea,button,picker{box-sizing:border-box;word-break:break-word}.container{padding:30rpx 32rpx 48rpx}.card,.module-card{background:#fff;border:1rpx solid #e5e9f0;border-radius:12rpx;padding:28rpx;margin-bottom:22rpx;box-shadow:0 2rpx 10rpx rgba(36,62,90,.035)}.hero{background:linear-gradient(125deg,#4A90D9,#357ABD);padding:32rpx 28rpx;color:white;border-radius:12rpx;margin-bottom:24rpx}.hero-title{font-size:38rpx;font-weight:700}.hero-meta{font-size:26rpx;margin-top:12rpx;opacity:.88}.section{display:flex;align-items:center;justify-content:space-between;margin:32rpx 0 20rpx}.section-title,.card-title{font-size:32rpx;font-weight:650}.subtle{font-size:25rpx;color:#768295;line-height:1.65}.card-title+.subtle{margin-top:8rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx;min-height:88rpx}.grow{flex:1;min-width:0}.arrow{font-size:42rpx;color:#adb4bf}.badge{font-size:23rpx;padding:7rpx 14rpx;border-radius:8rpx;background:#edf3fb;color:#357ABD;white-space:nowrap}.badge.green{background:#e8f5ee;color:#238361}.badge.orange{background:#fff2df;color:#ad6b17}.badge.red{background:#fdeceb;color:#bc4a48}.badge.purple{background:#f1ecfa;color:#7d5bab}.error{background:#fff0ef;color:#a43e37;padding:20rpx;border-radius:10rpx;margin-bottom:20rpx;font-size:27rpx;line-height:1.6}.empty{text-align:center;color:#8993a2;padding:64rpx 20rpx;font-size:28rpx}.stats{display:flex;gap:12rpx;margin:24rpx 0}.stat{flex:1;background:#fff;border:1rpx solid #e5e9f0;border-radius:12rpx;padding:24rpx 10rpx;text-align:center}.stat strong,.stat-value{display:block;font-size:40rpx;font-weight:700;color:#357ABD}.stat-label{font-size:24rpx;color:#768295;margin-top:10rpx}.filter-bar{display:flex;justify-content:space-between;align-items:center;margin:24rpx 0}.filter-label{font-size:25rpx;color:#667085}.filter-switch,.chips{display:flex;gap:8rpx;flex-wrap:wrap}.filter-switch{background:#e8edf5;padding:4rpx;border-radius:8rpx}.filter-option,.chip{padding:13rpx 18rpx;font-size:25rpx;color:#667085;border-radius:7rpx}.filter-option.active,.chip.active{background:#fff;color:#245f9e;font-weight:600;box-shadow:0 1rpx 5rpx #dce3ed}.chip{background:#e8edf5}.module-card{display:flex;align-items:center;min-height:142rpx;gap:22rpx}.module-icon,.tool-icon{width:76rpx;height:76rpx;line-height:76rpx;text-align:center;border-radius:18rpx;color:white;font-size:32rpx;font-weight:700;flex-shrink:0;background:#4A90D9}.blue{background:#4A90D9}.orange{background:#df8550}.green{background:#239880}.purple{background:#9170b5}.red{background:#da665e}.module-title{font-size:34rpx;font-weight:650}.module-meta{font-size:25rpx;color:#89919e;margin-top:9rpx}.tool-grid{display:flex;flex-wrap:wrap;gap:24rpx 0}.tool{width:33.333%;display:flex;align-items:center;flex-direction:column;gap:14rpx;padding:12rpx 0;font-size:26rpx}.tool-icon{width:68rpx;height:68rpx;line-height:68rpx;border-radius:15rpx;font-size:29rpx}.title{font-size:36rpx;font-weight:700}.field{margin:24rpx 0}.label{display:block;font-size:26rpx;color:#536377;margin-bottom:12rpx}input,textarea,.picker{background:#f6f8fb;border:1rpx solid #dde4ee;border-radius:9rpx;padding:22rpx;font-size:29rpx;width:100%;color:#263445}input{height:92rpx}textarea{min-height:190rpx;line-height:1.7}.picker{min-height:88rpx}button{font-size:29rpx;border-radius:9rpx;margin-top:20rpx;min-height:84rpx;line-height:84rpx}button::after{border:0}button[type=primary]{background:#4A90D9;color:white}button[disabled]{opacity:.5}button.mini{font-size:25rpx;line-height:68rpx;min-height:68rpx;margin-top:14rpx;padding:0 22rpx;background:#edf3fb;color:#357ABD}.actions{display:flex;gap:16rpx;flex-wrap:wrap}.actions button{flex:1;min-width:180rpx}.divider{height:1rpx;background:#ecf0f5;margin:24rpx 0}.detail-text{white-space:pre-wrap;font-size:28rpx;line-height:1.8;margin-top:16rpx}.file{font-size:27rpx;color:#357ABD;padding:22rpx 0;border-bottom:1rpx solid #edf0f5}.timeline{border-left:3rpx solid #d8e6f5;margin-left:6rpx;padding:0 0 26rpx 24rpx}.timeline-title{font-size:28rpx;font-weight:600}.note{background:#f0f5fc;border-radius:9rpx;padding:18rpx 22rpx;font-size:26rpx;color:#4f6f95;line-height:1.7;margin:18rpx 0}.danger{color:#b5463e!important;background:#fff0ef!important}.search{margin:24rpx 0}.account{text-align:center;padding:20rpx 0}.avatar{width:112rpx;height:112rpx;line-height:112rpx;border-radius:56rpx;background:#eaf3fc;color:#357ABD;font-size:46rpx;font-weight:700;margin:0 auto 22rpx}.login-hero{padding:80rpx 0 40rpx}.login-mark{width:100rpx;height:100rpx;background:#4A90D9;color:#fff;line-height:100rpx;text-align:center;border-radius:24rpx;font-size:48rpx;font-weight:bold;margin-bottom:30rpx}.footer{padding:30rpx 0;text-align:center;font-size:24rpx;color:#929baa;line-height:1.8}.select-line{padding:14rpx 0;display:flex;align-items:center;font-size:28rpx}.selected-files{padding:12rpx 0;color:#697b91;font-size:25rpx}.body-preview{overflow:hidden}.task-title{font-size:30rpx;font-weight:600;line-height:1.55}.list-count{font-size:25rpx;color:#8793a3}
