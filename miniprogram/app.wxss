/* app.wxss - 全局样式 */
page {
  background-color: #F5F6FA;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Helvetica, 'Microsoft YaHei', '微软雅黑', sans-serif;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
}

view, text, input, textarea, button, picker, scroll-view, swiper, swiper-item {
  box-sizing: border-box;
  font-family: inherit;
}

/* 通用容器 */
.container {
  padding: 30rpx;
}

/* 卡片样式 */
.card {
  background: #fff;
  border: 2rpx solid #E5E9F0;
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

/* 主色调按钮 */
.btn-primary {
  background: linear-gradient(135deg, #4A90D9, #357ABD);
  color: #fff;
  border: none;
  border-radius: 10rpx;
  padding: 26rpx 0;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  width: 100%;
}

.btn-primary[disabled] {
  background: #ccc;
  color: #fff;
}

.btn-secondary {
  background: #fff;
  color: #4A90D9;
  border: 2rpx solid #4A90D9;
  border-radius: 10rpx;
  padding: 22rpx 0;
  font-size: 30rpx;
  text-align: center;
  width: 100%;
}

/* 表单样式 */
.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  background: #F5F6FA;
  border: 2rpx solid #D9DEE7;
  border-radius: 8rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  width: 100%;
}

.form-textarea {
  background: #F5F6FA;
  border: 2rpx solid #D9DEE7;
  border-radius: 8rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  width: 100%;
  min-height: 160rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.tag-admin {
  background: #FFF0F0;
  color: #E74C3C;
}

.tag-minister {
  background: #E8F4FD;
  color: #4A90D9;
}

.tag-member {
  background: #F0F0F0;
  color: #666;
}

/* 列表项 */
.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 2rpx solid #F0F0F0;
}

.list-item:last-child {
  border-bottom: none;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 30rpx;
}

/* 顶部数据展示 */
.stat-row {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #4A90D9;
}

.stat-label {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 表格样式 */
.table {
  width: 100%;
  border-collapse: collapse;
  font-size: 26rpx;
}

.table-header {
  display: flex;
  background: #4A90D9;
  color: #fff;
  border-radius: 8rpx 8rpx 0 0;
}

.table-header .table-cell {
  padding: 18rpx 10rpx;
  text-align: center;
  font-weight: 500;
}

.table-row {
  display: flex;
  border-bottom: 2rpx solid #F0F0F0;
}

.table-row .table-cell {
  padding: 18rpx 10rpx;
  text-align: center;
  color: #333;
}

.table-row:nth-child(even) {
  background: #FAFBFC;
}
