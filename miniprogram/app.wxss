/* app.wxss - 全局样式 */
page {
  background-color: #F5F6FA;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Helvetica, 'Microsoft YaHei', '微软雅黑', sans-serif;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
  /* 统一字号阶梯 */
  --fs-xs: 24rpx;
  --fs-sm: 26rpx;
  --fs-base: 30rpx;
  --fs-md: 32rpx;
  --fs-lg: 34rpx;
  --fs-xl: 40rpx;
  --fs-xxl: 44rpx;
}

/* 小屏适配（宽度 < 320px）：整体缩小 */
@media (max-width: 320px) {
  page {
    --fs-xs: 22rpx;
    --fs-sm: 24rpx;
    --fs-base: 28rpx;
    --fs-md: 30rpx;
    --fs-lg: 32rpx;
    --fs-xl: 38rpx;
    --fs-xxl: 42rpx;
    font-size: 28rpx;
  }
  .container { padding: 24rpx; }
  .card { padding: 24rpx; }
}

/* 大屏适配（宽度 > 414px）：整体放大 */
@media (min-width: 415px) {
  page {
    --fs-xs: 26rpx;
    --fs-sm: 28rpx;
    --fs-base: 32rpx;
    --fs-md: 34rpx;
    --fs-lg: 36rpx;
    --fs-xl: 42rpx;
    --fs-xxl: 48rpx;
    font-size: 32rpx;
  }
}

view, text, input, textarea, button, picker, scroll-view, swiper, swiper-item {
  box-sizing: border-box;
  font-family: inherit;
  word-break: break-all;
}

/* 文本溢出兜底 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 通用容器 */
.container {
  padding: 30rpx;
}

/* 卡片样式 */
.card {
  background: #fff;
  border: 2rpx solid #E5E9F0;
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

/* 主色调按钮 */
.btn-primary {
  background: linear-gradient(135deg, #4A90D9, #357ABD);
  color: #fff;
  border: none;
  border-radius: 10rpx;
  padding: 26rpx 0;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  width: 100%;
}

.btn-primary[disabled] {
  background: #ccc;
  color: #fff;
}

.btn-secondary {
  background: #fff;
  color: #4A90D9;
  border: 2rpx solid #4A90D9;
  border-radius: 10rpx;
  padding: 22rpx 0;
  font-size: 30rpx;
  text-align: center;
  width: 100%;
}

/* 表单样式 */
.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  background: #F5F6FA;
  border: 2rpx solid #D9DEE7;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  line-height: 1.6;
  height: 72rpx;
  width: 100%;
  box-sizing: border-box;
}

.form-textarea {
  background: #F5F6FA;
  border: 2rpx solid #D9DEE7;
  border-radius: 8rpx;
  padding: 18rpx 24rpx;
  font-size: 30rpx;
  line-height: 1.6;
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.tag-admin {
  background: #FFF0F0;
  color: #E74C3C;
}

.tag-minister {
  background: #E8F4FD;
  color: #4A90D9;
}

.tag-member {
  background: #F0F0F0;
  color: #666;
}

/* 列表项 */
.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 2rpx solid #F0F0F0;
}

.list-item:last-child {
  border-bottom: none;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 30rpx;
}

/* 顶部数据展示 */
.stat-row {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #4A90D9;
}

.stat-label {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 表格样式 */
.table {
  width: 100%;
  border-collapse: collapse;
  font-size: 26rpx;
}

.table-header {
  display: flex;
  background: #4A90D9;
  color: #fff;
  border-radius: 8rpx 8rpx 0 0;
}

.table-header .table-cell {
  padding: 18rpx 10rpx;
  text-align: center;
  font-weight: 500;
}

.table-row {
  display: flex;
  border-bottom: 2rpx solid #F0F0F0;
}

.table-row .table-cell {
  padding: 18rpx 10rpx;
  text-align: center;
  color: #333;
}

.table-row:nth-child(even) {
  background: #FAFBFC;
}
