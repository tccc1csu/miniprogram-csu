/* pages/manage/manage.wxss */
.tab-bar {
  display: flex;
  background: #fff;
  border: 2rpx solid #E5E9F0;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #4A90D9;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #4A90D9;
  border-radius: 3rpx;
}

.add-btn-wrap {
  margin-bottom: 24rpx;
}

.member-info {
  display: flex;
  flex-direction: column;
}

.member-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.member-dept {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.dept-item-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.action-delete-text {
  font-size: 26rpx;
  color: #E74C3C;
  padding: 8rpx 20rpx;
}

.user-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F0F0F0;
}

.user-item:last-child {
  border-bottom: none;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.user-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.user-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.mini-tag {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 1.4;
}

.bind-tag {
  color: #999;
  background: #F0F0F0;
}

.bind-tag.bound {
  color: #2E8B57;
  background: #EAF7EF;
}

.test-tag {
  color: #B7791F;
  background: #FFF7E6;
}

.user-dept {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.user-actions {
  display: flex;
  align-items: center;
}

.action-role {
  font-size: 26rpx;
  color: #4A90D9;
  padding: 8rpx 20rpx;
  margin-right: 10rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 86%;
  background: #fff;
  border: 2rpx solid #E5E9F0;
  border-radius: 12rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 30rpx;
  color: #333;
}

.modal-content .form-input {
  width: 100%;
}

.modal-content .picker-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #F5F6FA;
  border: 2rpx solid #D9DEE7;
  border-radius: 8rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
}

.modal-content .static-value {
  background: #F5F6FA;
  border: 2rpx solid #D9DEE7;
  border-radius: 8rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  color: #666;
}

.modal-actions {
  display: flex;
  margin-top: 30rpx;
}

.modal-actions .btn-secondary {
  flex: 1;
  margin-right: 20rpx;
}

.modal-actions .modal-confirm {
  flex: 1;
  margin: 0;
}
