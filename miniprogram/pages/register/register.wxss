/* pages/register/register.wxss */
.register-page {
  min-height: 100vh;
  padding: 60rpx 40rpx;
  background: linear-gradient(180deg, #4A90D9 0%, #6BB0E8 30%, #F5F6FA 30%);
}

.logo-area {
  text-align: center;
  padding: 30rpx 0 70rpx;
}

.logo-icon {
  width: 140rpx;
  height: 140rpx;
  line-height: 140rpx;
  margin: 0 auto 24rpx;
  border-radius: 30rpx;
  background: #fff;
  color: #4A90D9;
  font-size: 70rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.logo-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
}

.logo-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
}

.register-form {
  padding: 40rpx 36rpx;
}

.picker-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #F5F6FA;
  border: 2rpx solid #D9DEE7;
  border-radius: 8rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  color: #333;
}

.arrow {
  color: #999;
  font-size: 24rpx;
}

.switch-link {
  text-align: center;
  margin-top: 40rpx;
  font-size: 26rpx;
  color: #999;
}

.switch-link .link-text {
  color: #4A90D9;
  font-weight: 500;
  margin-left: 8rpx;
}
