<!--pages/register/register.wxml-->
<view class="register-page">
  <view class="logo-area">
    <view class="logo-icon">青</view>
    <view class="logo-title">注册并绑定微信</view>
    <view class="logo-subtitle">青年传媒中心工作统计系统</view>
  </view>

  <view class="register-form card">
    <view class="form-group">
      <text class="form-label">姓名</text>
      <input class="form-input" type="text" placeholder="请输入您的姓名" value="{{name}}" bindinput="onNameInput" />
    </view>

    <view class="form-group">
      <text class="form-label">密码</text>
      <input class="form-input" password="true" placeholder="至少4位密码" value="{{password}}" bindinput="onPasswordInput" />
    </view>

    <view class="form-group">
      <text class="form-label">确认密码</text>
      <input class="form-input" password="true" placeholder="再次输入密码" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" />
    </view>

    <view class="form-group">
      <text class="form-label">身份角色</text>
      <picker mode="selector" range="{{roleList}}" range-key="label" bindchange="onRoleChange" value="{{roleIndex}}">
        <view class="picker-value">
          <text>{{roleList[roleIndex].label}}</text>
          <text class="arrow">▾</text>
        </view>
      </picker>
    </view>

    <view class="form-group" wx:if="{{role === 'admin'}}">
      <text class="form-label">管理员邀请码</text>
      <input class="form-input" password="true" placeholder="请输入管理员邀请码" value="{{inviteCode}}" bindinput="onInviteCodeInput" />
    </view>

    <view class="form-group" wx:if="{{role !== 'admin'}}">
      <text class="form-label">所属部门</text>
      <picker mode="selector" range="{{departmentList}}" bindchange="onDepartmentChange" value="{{departmentIndex}}">
        <view class="picker-value">
          <text>{{departmentList[departmentIndex]}}</text>
          <text class="arrow">▾</text>
        </view>
      </picker>
    </view>

    <button class="btn-primary" bindtap="handleRegister" loading="{{loading}}" disabled="{{loading}}">注册并绑定</button>
  </view>

  <view class="switch-link" bindtap="goLogin">
    <text>已有账号？</text>
    <text class="link-text">去登录</text>
  </view>
</view>
