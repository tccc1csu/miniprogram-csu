/* pages/upload/upload.wxss */
.upload-header {
  background: linear-gradient(135deg, #4A90D9, #357ABD);
  border-radius: 16rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.dept-badge {
  font-size: 30rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 24rpx;
  border-radius: 10rpx;
}

.week-picker {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 10rpx 24rpx;
  border-radius: 10rpx;
}

.week-text {
  font-size: 28rpx;
  font-weight: 500;
  margin-right: 10rpx;
}

.arrow {
  font-size: 22rpx;
  opacity: 0.8;
}

.header-summary {
  display: flex;
  justify-content: space-around;
  padding-top: 10rpx;
}

.summary-item {
  text-align: center;
}

.summary-num {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
}

.summary-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

.self-report {
  padding: 30rpx;
}

.allowance-state {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 22rpx;
  margin-bottom: 28rpx;
  background: #F5F6FA;
  border-radius: 10rpx;
  color: #666;
  font-size: 26rpx;
}

.state-pending {
  color: #B7791F;
  font-weight: 600;
}

.state-done {
  color: #2E8B57;
  font-weight: 600;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #F5F6FA;
  border: 2rpx solid #E8E8E8;
  border-radius: 10rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
}

/* 批量表格 */
.batch-table {
  padding: 0;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.table-header-row {
  display: flex;
  background: #F5F6FA;
  padding: 16rpx 0;
}

.th {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
  text-align: center;
}

.th-name { width: 120rpx; flex-shrink: 0; }
.th-type { width: 132rpx; flex-shrink: 0; }
.th-content { flex: 1; }
.th-workload { width: 86rpx; flex-shrink: 0; }
.th-allowance { width: 86rpx; flex-shrink: 0; }

.table-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F0F0F0;
  min-height: 90rpx;
}

.table-row:last-child {
  border-bottom: none;
}

.row-uploaded {
  background: #F0FFF4;
}

/* 待津贴高亮 */
.row-allowance-pending {
  background: #FFF8E1;
  border-left: 6rpx solid #FF9800;
}

.td {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 8rpx;
}

.td-name {
  width: 120rpx;
  flex-shrink: 0;
  align-items: center;
}

.member-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.status-badge {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-top: 6rpx;
}

.status-done {
  background: #D4EDDA;
  color: #155724;
}

.status-ready {
  background: #FFF3CD;
  color: #856404;
}

.status-pending {
  background: #F8D7DA;
  color: #721C24;
}

.allowance-tag {
  display: inline-block;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-top: 6rpx;
  background: #FFE0B2;
  color: #E65100;
  font-weight: 600;
}

.td-content {
  flex: 1;
}

.td-type {
  width: 132rpx;
  flex-shrink: 0;
}

.inline-picker {
  min-height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 4rpx;
  padding: 8rpx 10rpx;
  font-size: 22rpx;
  color: #333;
  background: #F9FAFB;
  border: 2rpx solid #E8E8E8;
  border-radius: 8rpx;
}

.inline-textarea {
  width: 100%;
  min-height: 60rpx;
  padding: 8rpx 12rpx;
  font-size: 24rpx;
  color: #333;
  background: #F9FAFB;
  border: 2rpx solid #E8E8E8;
  border-radius: 8rpx;
  line-height: 1.4;
}

.td-workload, .td-allowance {
  width: 86rpx;
  flex-shrink: 0;
  align-items: center;
}

.inline-input {
  width: 100%;
  padding: 8rpx 4rpx;
  font-size: 24rpx;
  text-align: center;
  background: #F9FAFB;
  border: 2rpx solid #E8E8E8;
  border-radius: 8rpx;
}

/* 待津贴输入框高亮 */
.input-pending {
  background: #FFF3E0;
  border: 2rpx solid #FF9800;
}

/* 操作栏 */
.action-bar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.btn-clear {
  width: 160rpx;
  background: #fff;
  color: #999;
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 22rpx 0;
}

.btn-submit {
  flex: 1;
}

/* 一键补津贴按钮 */
.btn-allowance {
  width: 200rpx;
  background: #FFF3E0;
  color: #E65100;
  border: 2rpx solid #FF9800;
  border-radius: 12rpx;
  font-size: 26rpx;
  padding: 22rpx 0;
  font-weight: 600;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 86%;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 16rpx;
  color: #333;
}

.modal-desc {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-bottom: 30rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.modal-actions .btn-secondary,
.modal-actions .modal-confirm {
  flex: 1;
}

/* 快捷预设 */
.preset-row {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.preset-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #F5F6FA;
  border: 2rpx solid #E8E8E8;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 通用表单 */
.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  background: #F5F6FA;
  border: 2rpx solid #E8E8E8;
  border-radius: 10rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  background: #F5F6FA;
  border: 2rpx solid #E8E8E8;
  border-radius: 10rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}
