<view class="container"><view class="hero"><view class="hero-title">我的工时</view><view class="hero-meta">只展示本人记录，核定工时与规则工时分开保留</view></view><view class="error" wx:if="{{error}}">{{error}}</view><view class="stats"><view class="stat"><view class="stat-value">{{total.hours}}</view><view class="stat-label">工时</view></view><view class="stat"><view class="stat-value">{{total.amount}}</view><view class="stat-label">金额（元）</view></view><view class="stat"><view class="stat-value">{{total.count}}</view><view class="stat-label">记录</view></view></view><view class="card" wx:for="{{rows}}" wx:key="id"><view class="row"><view class="grow task-title">{{item.title}}</view><text class="badge {{item.confirmed?'green':'orange'}}">{{item.confirmed?'已核定':'待核定'}}</text></view><view class="subtle">{{item.name}} · {{item.department}} · {{item.created_at}}</view><view class="row"><text>规则工时 {{item.baseHours}} h</text><text>核定 {{item.hours}} h</text></view><view class="note" wx:if="{{item.taskNote || item.adjustmentNote}}">{{item.taskNote}} {{item.adjustmentNote}}</view></view><view class="empty" wx:if="{{!loading && !rows.length}}">暂无工时记录</view></view>
