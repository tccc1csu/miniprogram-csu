/* pages/suggestions/suggestions.wxss */
.container {
  padding-bottom: 40rpx;
}

.tab-bar {
  display: flex;
  background: #fff;
  margin-bottom: 16rpx;
  border-radius: 0 0 16rpx 16rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
}

.tab-item.active {
  color: #4A90D9;
  border-bottom-color: #4A90D9;
  font-weight: 600;
}

.filter-bar {
  padding: 0 20rpx 16rpx;
}

.filter-picker {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background: #fff;
  border-radius: 8rpx;
}

.filter-label {
  font-size: 26rpx;
  color: #333;
  margin-right: 10rpx;
}

.filter-arrow {
  font-size: 20rpx;
  color: #999;
}

/* 建议卡片 */
.suggestion-list {
  padding: 0 20rpx;
}

.suggestion-card {
  margin-bottom: 20rpx;
  padding: 24rpx 30rpx;
}

.suggestion-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.suggestion-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.status-pending {
  background: #FFF3CD;
  color: #856404;
}

.status-approved {
  background: #D4EDDA;
  color: #155724;
}

.status-rejected {
  background: #F8D7DA;
  color: #721C24;
}

.suggestion-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.suggestion-meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}

.admin-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.admin-actions button {
  margin: 0;
  flex: 1;
}

/* 投票 */
.vote-list {
  padding: 0 20rpx;
}

.vote-card {
  margin-bottom: 20rpx;
  padding: 24rpx 30rpx;
}

.vote-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.vote-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.vote-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.vote-status.active {
  background: #D4EDDA;
  color: #155724;
}

.vote-status.closed {
  background: #E2E3E5;
  color: #383D41;
}

.vote-options {
  margin-bottom: 16rpx;
}

.vote-option {
  position: relative;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #F5F6FA;
  border-radius: 10rpx;
  border: 2rpx solid transparent;
}

.vote-option.voted {
  border-color: #4A90D9;
  background: rgba(74,144,217,0.08);
}

.option-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.option-text {
  font-size: 28rpx;
  color: #333;
}

.option-count {
  font-size: 24rpx;
  color: #999;
}

.option-bar-bg {
  height: 12rpx;
  background: #E8E8E8;
  border-radius: 6rpx;
  overflow: hidden;
}

.option-bar {
  height: 100%;
  background: linear-gradient(90deg, #4A90D9, #6BA5E7);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.vote-check {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: #4A90D9;
  color: #fff;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.vote-meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}

/* 通知 */
.notice-list {
  padding: 0 20rpx;
}

.notice-card {
  margin-bottom: 16rpx;
  padding: 24rpx 30rpx;
}

.notice-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.notice-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.notice-time {
  font-size: 24rpx;
  color: #999;
}

/* 公共 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 50rpx;
  background: linear-gradient(135deg, #4A90D9, #357ABD);
  color: #fff;
  font-size: 56rpx;
  font-weight: 300;
  box-shadow: 0 6rpx 20rpx rgba(74,144,217,0.4);
  z-index: 10;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}

.modal-panel {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 640rpx;
  max-height: 80vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  z-index: 101;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 30rpx;
}

.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.form-row.vertical {
  flex-direction: column;
  align-items: flex-start;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  background: #F5F6FA;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  padding: 16rpx 20rpx;
  background: #F5F6FA;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.modal-btns button {
  flex: 1;
  margin: 0;
}

.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #bbb;
}

button.small {
  padding: 10rpx 20rpx;
  font-size: 26rpx;
  line-height: 1.4;
}
