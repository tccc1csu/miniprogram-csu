/* pages/externalRequest/externalRequest.wxss */
.container {
  padding: 20rpx;
  min-height: 100vh;
  background: #f5f6fa;
  box-sizing: border-box;
}

.layout-summary {
  background: linear-gradient(135deg, #16A085, #0E6655);
  color: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.summary-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.summary-path {
  font-size: 24rpx;
  opacity: 0.9;
  line-height: 1.5;
}

.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 8rpx;
}

.tab-item.active {
  background: #16A085;
  color: #fff;
  font-weight: 600;
}

.create-entry {
  margin-bottom: 20rpx;
}

.btn-primary {
  background: #16A085;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #ecf0f1;
  color: #555;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 16rpx 0;
  border: none;
}

.btn-secondary::after {
  border: none;
}

.modal-confirm {
  margin-left: 16rpx;
}

.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 28rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.handoff-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.handoff-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 8rpx;
}

.handoff-meta {
  font-size: 24rpx;
  color: #888;
}

.status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  color: #fff;
  white-space: nowrap;
}

.status-submitted { background: #f39c12; }
.status-assigned { background: #3498db; }
.status-completed { background: #9b59b6; }
.status-archived { background: #27ae60; }
.status-rejected { background: #e74c3c; }

.deadline-bar {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
  gap: 12rpx;
}

.deadline-text.deadline-urgent {
  color: #e74c3c;
  font-weight: 600;
}

.deadline-date {
  margin-left: auto;
  color: #999;
}

.handoff-section {
  margin-top: 12rpx;
}

.section-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.section-text {
  font-size: 28rpx;
  color: #333;
}

.attachment-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.attachment-item {
  display: inline-flex;
  align-items: center;
  background: #f0f3f7;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #555;
}

.attachment-name {
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attachment-remove {
  margin-left: 12rpx;
  color: #e74c3c;
  font-weight: 700;
}

.upload-btn {
  background: #ecf0f1;
  color: #555;
  border-radius: 8rpx;
  font-size: 26rpx;
  padding: 12rpx 0;
  margin-top: 12rpx;
}

.upload-btn::after {
  border: none;
}

.flow-step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.step-index {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #16A085;
  color: #fff;
  text-align: center;
  line-height: 48rpx;
  font-size: 26rpx;
  font-weight: 700;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.step-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.step-text {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-content {
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #222;
  text-align: center;
  margin-bottom: 24rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #555;
  margin-bottom: 10rpx;
}

.form-input, .form-picker, .form-textarea {
  width: 100%;
  background: #f5f6fa;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-textarea {
  min-height: 140rpx;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #333;
}

.modal-actions {
  display: flex;
  margin-top: 24rpx;
}

.modal-actions .btn-secondary,
.modal-actions .btn-primary {
  flex: 1;
}

.mini-btn {
  background: #ecf0f1;
  color: #555;
  border-radius: 10rpx;
  font-size: 26rpx;
  padding: 14rpx 24rpx;
  border: none;
  margin-right: 12rpx;
}

.mini-btn::after {
  border: none;
}

.mini-btn.primary {
  background: #16A085;
  color: #fff;
}

.detail-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}

.detail-label {
  color: #888;
  width: 180rpx;
  flex-shrink: 0;
}

.detail-value {
  color: #333;
  flex: 1;
}

.detail-attachments {
  flex: 1;
}
