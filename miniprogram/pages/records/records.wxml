<view class="container"><view class="hero"><view class="hero-title">{{title||'任务记录'}}</view><view class="hero-meta">同一任务，手机与网页实时衔接</view></view><view class="error" wx:if="{{error}}">{{error}}</view><button wx:if="{{canCreate}}" type="primary" bindtap="create">＋ 发起{{title}}</button><view class="search"><input placeholder="搜索任务标题或编号" value="{{query}}" bindinput="search"/></view><view class="chips"><view wx:for="{{filters}}" wx:key="id" class="chip {{filter===item.id?'active':''}}" data-id="{{item.id}}" bindtap="pick">{{item.label}}</view></view><view class="section"><text class="list-count">共 {{rows.length}} 条</text><text class="subtle" wx:if="{{loading}}">刷新中…</text></view><view wx:for="{{rows}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view class="row"><view class="grow task-title">{{item.title}}</view><text class="badge {{item.publicOnly ? (item.registered?'green':'orange') : item.tone}}">{{item.publicOnly ? (item.registered?'已报名':'开放报名') : item.stateLabel}}</text></view><view class="subtle">{{item.kindLabel}} · {{item.number}}</view><view class="note" wx:if="{{!item.publicOnly}}">{{item.next}} · {{item.owner}}</view><view class="subtle">{{item.timeLabel}}</view></view><view class="card empty" wx:if="{{!loading && !rows.length}}">暂无符合条件的任务</view></view>
