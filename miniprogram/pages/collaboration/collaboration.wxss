/* pages/collaboration/collaboration.wxss */
.square-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 30rpx;
  margin-bottom: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #4A90D9, #357ABD);
  border-radius: 12rpx;
}

.square-title {
  font-size: 38rpx;
  font-weight: 700;
}

.square-meta {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
}

.module-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.filter-label {
  color: #666;
  font-size: 25rpx;
}

.filter-switch {
  display: flex;
  padding: 4rpx;
  background: #E8EDF5;
  border: 2rpx solid #D9DEE7;
  border-radius: 8rpx;
}

.filter-option {
  padding: 14rpx 18rpx;
  color: #667085;
  font-size: 26rpx;
  border-radius: 6rpx;
}

.filter-option.active {
  color: #245F9E;
  background: #fff;
  font-weight: 600;
}

.module-card {
  display: flex;
  align-items: center;
  min-height: 140rpx;
  padding: 28rpx;
  background: #fff;
  border: 2rpx solid #E5E9F0;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.module-card.disabled {
  opacity: 0.5;
}

.module-icon {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 18rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.activity-icon {
  background: linear-gradient(135deg, #5BB85B, #3E9E64);
}

.handoff-icon {
  background: linear-gradient(135deg, #4A90D9, #357ABD);
}

.production-icon {
  background: linear-gradient(135deg, #E98952, #C75B37);
}

.project-icon {
  background: linear-gradient(135deg, #E74C3C, #C0392B);
}

.module-body {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.module-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}

.module-meta {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #888;
}

.module-arrow {
  color: #bbb;
  font-size: 44rpx;
  flex-shrink: 0;
}
