<view class="container"><view class="error" wx:if="{{error}}">{{error}}</view><view class="hero"><view class="hero-title">协作广场</view><view class="hero-meta">{{user.name}} · {{roleLabel}} · {{departmentLabel}}</view></view><view class="filter-bar"><text class="filter-label">流程范围</text><view class="filter-switch"><view class="filter-option {{departmentFilter==='all'?'active':''}}" data-filter="all" bindtap="scope">查看全部</view><view class="filter-option {{departmentFilter==='mine'?'active':''}}" data-filter="mine" bindtap="scope">仅看本部门</view></view></view><view class="module-card" wx:for="{{modules}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="module-icon {{item.color}}">{{item.icon}}</view><view class="grow"><view class="module-title">{{item.title}}</view><view class="module-meta">{{item.meta}}</view></view><view class="arrow">›</view></view><view class="empty" wx:if="{{!modules.length}}">本部门暂无关联协作流程</view></view>