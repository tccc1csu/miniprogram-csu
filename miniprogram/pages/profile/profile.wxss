/* pages/profile/profile.wxss */
.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 30rpx 40rpx;
  background: linear-gradient(135deg, #4A90D9, #357ABD);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 130rpx;
  height: 130rpx;
  line-height: 130rpx;
  text-align: center;
  border-radius: 65rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 56rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
}

.profile-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
}

.profile-role {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
}

.profile-dept {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.tool-card {
  padding: 28rpx 24rpx;
}

.tool-grid {
  display: flex;
  flex-wrap: wrap;
}

.tool-item {
  width: 33.333%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0;
}

.tool-icon {
  width: 62rpx;
  height: 62rpx;
  line-height: 62rpx;
  text-align: center;
  border-radius: 16rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.tool-item text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.icon-record { background: linear-gradient(135deg, #4A90D9, #357ABD); }
.icon-stat { background: linear-gradient(135deg, #F0A030, #D88820); }
.icon-table { background: linear-gradient(135deg, #5BB85B, #4A9F4A); }
.icon-contact { background: linear-gradient(135deg, #3E9E64, #2F7D50); }
.icon-manage { background: linear-gradient(135deg, #9B59B6, #8E44AD); }
.icon-collab { background: linear-gradient(135deg, #5A6FEC, #4A5ED0); }
.icon-handoff { background: linear-gradient(135deg, #26A69A, #00897B); }

.info-card {
  padding: 30rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F0F0F0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #999;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.logout-area {
  margin: 30rpx 0;
}

.logout-btn {
  color: #E74C3C;
  border-color: #E74C3C;
}

.version-text {
  text-align: center;
  font-size: 24rpx;
  color: #ccc;
  padding: 20rpx 0;
}

/* 协同流程迷你图例 */
.flow-mini {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.flow-mini-step {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.flow-mini-dot {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #E0E0E0;
  color: #999;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.flow-mini-dot.dot-mine {
  background: #4A90D9;
  color: #fff;
}

.flow-mini-step text {
  font-size: 26rpx;
  color: #333;
}

.flow-mini-line {
  width: 2rpx;
  height: 28rpx;
  background: #E0E0E0;
  margin-left: 23rpx;
}

.handoff-hint {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #4A90D9;
  padding: 16rpx 0;
  border-top: 2rpx solid #F0F0F0;
}
