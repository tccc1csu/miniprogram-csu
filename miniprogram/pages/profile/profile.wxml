<view class="container"><view class="error" wx:if="{{error}}">{{error}}</view><block wx:if="{{user}}"><view class="card account"><view class="avatar">{{initial}}</view><view class="title">{{user.name}}</view><view class="subtle">{{roleLabel}} · {{departmentLabel}}</view></view><view class="card"><view class="card-title">常用工具</view><view class="divider"></view><view class="tool-grid"><view class="tool" data-url="/pages/records/records" bindtap="open"><view class="tool-icon blue">录</view><text>任务记录</text></view><view class="tool" wx:if="{{isInternal}}" data-url="/pages/statistics/statistics" bindtap="open"><view class="tool-icon green">时</view><text>我的工时</text></view><view class="tool" data-url="/pages/taskNotifications/taskNotifications" bindtap="open"><view class="tool-icon orange">讯</view><text>任务消息</text></view><view class="tool" data-url="/pages/records/records?filter=archived" bindtap="open"><view class="tool-icon purple">档</view><text>成果档案</text></view><view class="tool" wx:if="{{isInternal}}" data-url="/pages/allowanceRules/allowanceRules" bindtap="open"><view class="tool-icon blue">规</view><text>工时规则</text></view><view class="tool" bindtap="web"><view class="tool-icon green">网</view><text>网页版</text></view></view></view><view class="card"><view class="card-title">账号信息</view><view class="row"><text class="subtle">姓名</text><text>{{user.name}}</text></view><view class="row"><text class="subtle">身份</text><text>{{roleLabel}}</text></view><view class="row"><text class="subtle">部门</text><text>{{departmentLabel}}</text></view><view class="note">与网页共用账号和任务。复杂报表、期末封存、流程配置请在网页版办理。</view></view><button bindtap="logout">退出登录</button><view class="footer">青年传媒中心 · 两端同一份工作记录</view></block></view>