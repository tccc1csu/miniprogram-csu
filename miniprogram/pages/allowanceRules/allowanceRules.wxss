/* pages/allowanceRules/allowanceRules.wxss */
.page-intro { padding: 28rpx; }
.intro-text { color: #777; font-size: 24rpx; line-height: 1.6; }
.settings-card { padding: 28rpx; }
.section-head, .setting-row, .rule-title-row, .rule-actions { display: flex; align-items: center; }
.section-head { justify-content: space-between; }
.section-head .card-title { margin-bottom: 0; }
.readonly-tag { color: #999; background: #F0F0F0; border-radius: 8rpx; padding: 6rpx 12rpx; font-size: 22rpx; }
.setting-row { margin: 22rpx 0; }
.setting-label { flex: 1; color: #555; font-size: 26rpx; }
.number-input { width: 150rpx; padding: 14rpx 16rpx; text-align: right; background: #F5F6FA; border: 2rpx solid #E8E8E8; border-radius: 8rpx; font-size: 26rpx; }
.unit { width: 48rpx; margin-left: 10rpx; color: #888; font-size: 24rpx; }
.section-title { margin: 30rpx 0 16rpx; color: #333; font-size: 32rpx; font-weight: 600; }
.count { color: #999; font-size: 23rpx; font-weight: 400; }
.rule-card { padding: 24rpx; }
.rule-title-row { gap: 14rpx; margin-bottom: 18rpx; }
.rule-name { flex: 1; min-width: 0; color: #333; font-size: 30rpx; font-weight: 600; }
.rule-dept { color: #4A90D9; background: #E8F4FD; padding: 6rpx 12rpx; border-radius: 8rpx; font-size: 21rpx; }
.rule-grid { display: flex; flex-wrap: wrap; margin: 0 -8rpx; }
.rule-field { width: 50%; padding: 8rpx; }
.rule-field text { display: block; margin-bottom: 6rpx; color: #999; font-size: 21rpx; }
.rule-field input { width: 100%; padding: 12rpx; color: #444; background: #F8F9FB; border: 2rpx solid #EDF0F3; border-radius: 8rpx; font-size: 24rpx; }
.rule-actions { gap: 14rpx; margin-top: 18rpx; }
.mini-btn { flex: 1; padding: 14rpx 0; border: 2rpx solid #4A90D9; border-radius: 8rpx; color: #4A90D9; background: #fff; font-size: 23rpx; }
.mini-btn.primary { color: #fff; background: #4A90D9; }
.mini-btn.danger { color: #E74C3C; border-color: #E74C3C; }
.add-rule-btn { margin: 24rpx 0; }
.add-card { padding: 28rpx; }
.form-group { margin-bottom: 22rpx; }
.form-label { display: block; margin-bottom: 8rpx; color: #666; font-size: 25rpx; }
.form-input { width: 100%; padding: 18rpx 20rpx; color: #333; background: #F5F6FA; border: 2rpx solid #E8E8E8; border-radius: 8rpx; font-size: 26rpx; }
.form-row { display: flex; gap: 16rpx; margin-bottom: 18rpx; }
.form-input.half { flex: 1; min-width: 0; }
