<view class="container"><view class="hero"><view class="hero-title">工时规则</view><view class="hero-meta">当前云端生效规则只读查看，规则调整在网页版完成</view></view><view class="error" wx:if="{{error}}">{{error}}</view><view class="card" wx:if="{{policy}}"><view class="card-title">当前政策</view><view class="row"><text>普通时薪</text><text>{{policy.rate_cents / 100}} 元/时</text></view><view class="row"><text>加急倍率</text><text>{{policy.urgent_factor / 10000}} 倍</text></view><view class="row"><text>摄制预约窗口</text><text>{{policy.photo_window}} 小时</text></view></view><view class="section"><text class="section-title">适用规则</text><text class="subtle">{{rules.length}} 条</text></view><view class="card" wx:for="{{rules}}" wx:key="id"><view class="card-title">{{item.name}}</view><view class="subtle">{{item.department_id || '中心'}} · {{item.units / 10000}} 小时{{item.review ? ' · 审校' : ''}}</view></view><view class="empty" wx:if="{{!loading && !rules.length}}">暂无规则</view></view>
