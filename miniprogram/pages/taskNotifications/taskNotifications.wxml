<view class="container"><view class="hero"><view class="hero-title">任务消息</view><view class="hero-meta">这里是站内事件记录；微信机器人尚未接通</view></view><view class="error" wx:if="{{error}}">{{error}}</view><view class="card" wx:for="{{rows}}" wx:key="id" data-id="{{item.task_id}}" bindtap="open"><view class="row"><view class="grow task-title">{{item.payload.title || '任务有新进展'}}</view><text class="subtle">{{item.created_at}}</text></view><view class="note">{{item.payload.message || item.event}}</view></view><view class="empty" wx:if="{{!loading && !rows.length}}">暂无站内消息</view></view>
