<view class="container"><view class="login-hero"><view class="login-mark">青</view><view class="title">青年传媒中心</view><view class="subtle">协作有序，让每一份付出都有记录。</view></view><form class="card" bindsubmit="login"><view class="card-title">欢迎回来</view><view class="subtle">与网页使用同一个账号</view><view class="error" wx:if="{{error}}">{{error}}</view><view class="field"><text class="label">账号</text><input name="username" placeholder="请输入账号" maxlength="100"/></view><view class="field"><text class="label">密码</text><input name="password" placeholder="请输入密码" password maxlength="200"/></view><button type="primary" form-type="submit" loading="{{loading}}" disabled="{{loading}}">登录</button></form><view class="footer"><view>账号由中心统一管理</view><view>身份与权限由云端核验</view></view></view>