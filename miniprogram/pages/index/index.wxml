<view class="container"><view class="error" wx:if="{{error}}">{{error}}</view><block wx:if="{{user}}"><view class="hero"><view class="hero-title">{{user.name}}，你好</view><view class="hero-meta">{{roleLabel}} · {{departmentLabel}}</view></view><view class="stats"><view class="stat" data-filter="todo" bindtap="list"><view class="stat-value">{{stats.todo}}</view><view class="stat-label">我的待办</view></view><view class="stat" data-filter="active" bindtap="list"><view class="stat-value">{{stats.active}}</view><view class="stat-label">进行中</view></view><view class="stat" data-filter="archived" bindtap="list"><view class="stat-value">{{stats.archived}}</view><view class="stat-label">已归档</view></view></view><view class="card"><view class="tool-grid"><view class="tool" bindtap="collaboration"><view class="tool-icon blue">协</view><text>发起协作</text></view><view class="tool" bindtap="messages"><view class="tool-icon orange">讯</view><text>任务消息</text></view><view class="tool" wx:if="{{isInternal}}" bindtap="hours"><view class="tool-icon green">时</view><text>我的工时</text></view><view class="tool" wx:else data-filter="created" bindtap="list"><view class="tool-icon green">单</view><text>我发起的</text></view></view></view><view class="section"><text class="section-title">接下来要做</text><text class="subtle" data-filter="todo" bindtap="list">查看全部 ›</text></view><view class="card" wx:for="{{tasks}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="row"><view class="grow task-title">{{item.title}}</view><text class="badge {{item.tone}}">{{item.stateLabel}}</text></view><view class="subtle">{{item.kindLabel}} · {{item.number}}</view><view class="note">{{item.next}} · {{item.owner}}</view></view><view class="card empty" wx:if="{{!loading && !tasks.length}}">暂时没有待办，辛苦啦。<view class="subtle">你仍可在协作广场发起需求或查看任务。</view></view><view class="footer">正常完成后，成果和工时会自动归档。</view></block><view wx:elif="{{loading}}" class="empty">正在连接云端…</view></view>
