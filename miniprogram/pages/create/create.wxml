<view class="container"><view class="hero"><view class="hero-title">发起{{title}}</view><view class="hero-meta">填写需求，后续进度和材料都留在同一个任务里</view></view><view class="error" wx:if="{{error}}">{{error}}</view><view class="card" wx:if="{{user}}">
<view class="field"><text class="label">标题</text><input maxlength="180" placeholder="工作或需求标题" value="{{form.title}}" data-field="title" bindinput="input"/></view>
<block wx:if="{{kind!=='work_entry'}}"><view class="field"><text class="label">{{kind==='photo'?'预约时间':'截止时间（推文必填）'}}</text><picker mode="date" value="{{form.date}}" data-field="date" bindchange="input"><view class="picker">{{form.date||'选择日期'}}</view></picker><picker mode="time" value="{{form.time}}" data-field="time" bindchange="input"><view class="picker">{{form.time}}（北京时间）</view></picker></view></block>
<view class="field" wx:if="{{kind==='publication'}}"><text class="label">排版类型</text><view class="chips"><view class="chip {{form.layoutType==='basic'?'active':''}}" data-field="layoutType" data-value="basic" bindtap="choose">常规排版</view><view class="chip {{form.layoutType==='photo'?'active':''}}" data-field="layoutType" data-value="photo" bindtap="choose">影像排版</view><view class="chip {{form.layoutType==='repost'?'active':''}}" data-field="layoutType" data-value="repost" bindtap="choose">转载</view></view><view class="row"><text>开放外部组织报名</text><switch checked="{{form.openRegistration}}" bindchange="registration"/></view></view>
<block wx:if="{{kind==='photo'}}"><view class="field"><text class="label">拍摄地点</text><input value="{{form.location}}" data-field="location" bindinput="input"/></view><view class="field"><text class="label">联系人和联系方式</text><input value="{{form.contact}}" data-field="contact" bindinput="input"/></view><view class="field"><text class="label">加急说明（可选）</text><textarea value="{{form.urgentReason}}" data-field="urgentReason" bindinput="input"/></view></block>
<view class="field" wx:if="{{kind==='design'}}"><text class="label">设计复杂度</text><view class="chips"><view class="chip {{form.complexity==='basic'?'active':''}}" data-field="complexity" data-value="basic" bindtap="choose">基础设计</view><view class="chip {{form.complexity==='complex'?'active':''}}" data-field="complexity" data-value="complex" bindtap="choose">复杂设计</view><view class="chip {{form.complexity==='large'?'active':''}}" data-field="complexity" data-value="large" bindtap="choose">大型设计</view></view></view>
<block wx:if="{{kind==='web_article'}}"><view class="section-title">挂网稿件</view><view class="note">网站留空会登记院网、升华网和学工网各一条。原创作者与采编审校人员用于工时核算。</view><view wx:for="{{lines}}" wx:key="index" class="line-box"><input placeholder="稿件标题" value="{{item.title}}" data-index="{{index}}" data-field="title" bindinput="lineInput"/><input placeholder="网站（留空登记三个网站）" value="{{item.site}}" data-index="{{index}}" data-field="site" bindinput="lineInput"/><view class="row"><text>原创稿件</text><switch checked="{{item.original}}" data-index="{{index}}" bindchange="lineOriginal"/></view><picker wx:if="{{item.original}}" range="{{authors}}" range-key="name" data-index="{{index}}" bindchange="lineAuthor"><view class="picker">作者：{{item.authorName||'默认本人，请核对是否为采编成员'}}</view></picker><button class="mini danger" wx:if="{{lines.length>1}}" data-index="{{index}}" bindtap="removeLine">移除这一条</button></view><button class="mini" bindtap="addLine">＋ 增加稿件</button><view class="field"><text class="label">采编审校人员（至少一位，可多选）</text><view wx:for="{{reviewers}}" wx:key="id" class="select-line" data-id="{{item.id}}" bindtap="reviewer">{{item.checked?'☑':'□'}} {{item.name}}</view></view><picker range="{{teachers}}" range-key="name" value="{{teacherIndex}}" data-field="teacherIndex" bindchange="pick"><view class="picker">{{teachers[teacherIndex].name}}</view></picker></block>
<view class="field" wx:if="{{kind==='request'}}"><text class="label">承接部门</text><picker range="{{departments}}" range-key="name" value="{{departmentIndex}}" data-field="departmentIndex" bindchange="pick"><view class="picker">{{departments[departmentIndex].name||'选择部门'}}</view></picker></view>
<block wx:if="{{kind==='work_entry'}}"><view class="field"><text class="label">周次（1—53）</text><input type="number" value="{{form.week}}" data-field="week" bindinput="input"/></view><picker range="{{people}}" range-key="name" value="{{personIndex}}" data-field="personIndex" bindchange="pick"><view class="picker">{{people[personIndex].name||'选择成员'}}</view></picker></block>
<view class="field" wx:if="{{kind==='request'||kind==='work_entry'}}"><text class="label">适用工时规则</text><picker range="{{rules}}" range-key="name" value="{{ruleIndex}}" data-field="ruleIndex" bindchange="pick"><view class="picker">{{rules[ruleIndex].name}}</view></picker><input wx:if="{{kind==='work_entry'&&!ruleIndex}}" type="digit" placeholder="人工工时（小时）" value="{{form.hours}}" data-field="hours" bindinput="input"/><view class="subtle" wx:if="{{kind==='request'}}">除原创部外，请选择承接部门的创作规则。</view></view>
<view class="field"><text class="label">需求说明</text><textarea maxlength="10000" placeholder="背景、交付要求或工作说明；创建后可在任务中补交材料" value="{{form.notes}}" data-field="notes" bindinput="input"/></view><button type="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">创建任务</button><view class="subtle">创建成功后，在详情内补交供稿或附件。</view></view></view>
