/* pages/projectTasks/projectTasks.wxss */
.container {
  padding-bottom: 30rpx;
}

.page-header {
  background: linear-gradient(135deg, #E74C3C 0%, #C0392B 100%);
  color: #fff;
  padding: 40rpx 30rpx 50rpx;
}
.header-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.header-subtitle {
  font-size: 24rpx;
  opacity: 0.9;
}

.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin: -20rpx 24rpx 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 26rpx;
  color: #666;
}
.tab-item.active {
  color: #E74C3C;
  font-weight: 600;
  background: #FEF0F0;
}

/* 悬浮按钮 */
.fab-btn {
  position: fixed;
  right: 30rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E74C3C 0%, #C0392B 100%);
  color: #fff;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(231, 76, 60, 0.4);
  z-index: 99;
}

/* 项目卡片 */
.project-card {
  padding: 28rpx;
  margin: 20rpx 24rpx;
}
.project-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}
.project-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
}
.status-tag {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}
.status-active { background: #FEF0F0; color: #E74C3C; }
.status-completed { background: #EAF7EF; color: #2E8B57; }

.project-desc {
  color: #666;
  font-size: 26rpx;
  line-height: 1.5;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 阶段进度条 */
.phase-progress {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}
.phase-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #E0E0E0;
  color: #999;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.phase-dot.done {
  background: #2E8B57;
  color: #fff;
}
.phase-dot.current {
  background: #E74C3C;
  color: #fff;
  animation: pulse 1.5s infinite;
}
@keyframes pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(231, 76, 60, 0.4); }
  50% { box-shadow: 0 0 0 10rpx rgba(231, 76, 60, 0); }
}
.phase-line {
  flex: 1;
  height: 4rpx;
  background: #E0E0E0;
  margin: 0 8rpx;
}
.phase-line.line-done {
  background: #2E8B57;
}
.phase-text {
  text-align: center;
  color: #999;
  font-size: 22rpx;
  margin-bottom: 16rpx;
}

/* 部门标签 */
.dept-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.dept-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: #F0F0F0;
  color: #666;
}
.dept-tag.tag-done {
  background: #EAF7EF;
  color: #2E8B57;
}
.dept-tag.tag-doing {
  background: #FEF0F0;
  color: #E74C3C;
}

.project-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
  padding-top: 12rpx;
  border-top: 1rpx solid #F0F0F0;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #999; margin-bottom: 10rpx; }
.empty-hint { font-size: 24rpx; color: #bbb; }

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-content {
  width: 86%;
  max-height: 80vh;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx 30rpx;
  display: flex;
  flex-direction: column;
}
.large-modal {
  width: 92%;
  max-height: 85vh;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 20rpx;
  text-align: center;
}
.modal-scroll {
  flex: 1;
  max-height: 55vh;
  overflow-y: auto;
}
.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
}
.modal-actions button {
  flex: 1;
}

/* 表单 */
.form-group {
  margin-bottom: 24rpx;
}
.form-label {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}
.form-input, .form-textarea, .form-picker {
  width: 100%;
  background: #F5F6FA;
  border: 2rpx solid #E8E8E8;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}
.form-textarea {
  min-height: 120rpx;
}
.form-textarea.compact {
  min-height: 80rpx;
}
.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.arrow { color: #999; }

/* 部门多选 */
.dept-checkbox-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.dept-checkbox {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  background: #fff;
}
.dept-checkbox.checked {
  border-color: #E74C3C;
  background: #FEF0F0;
  color: #E74C3C;
}
.check-box {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #ccc;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
}
.dept-checkbox.checked .check-box {
  background: #E74C3C;
  border-color: #E74C3C;
}

/* 阶段编辑 */
.phase-edit-list {
  margin-bottom: 16rpx;
}
.phase-edit-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.phase-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #E74C3C;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.phase-input {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
}
.phase-remove {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F5F5F5;
  color: #999;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.add-phase-btn {
  text-align: center;
  color: #E74C3C;
  font-size: 26rpx;
  padding: 16rpx 0;
  border: 2rpx dashed #E74C3C;
  border-radius: 12rpx;
}

/* 详情 */
.detail-section {
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}
.detail-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
  font-size: 26rpx;
}
.meta-label { color: #999; }
.meta-value { color: #333; text-align: right; flex: 1; }

.text-success { color: #2E8B57; }
.text-primary { color: #E74C3C; }
.text-aux { color: #999; }

/* 纵向阶段流程 */
.phase-flow {
  padding-left: 10rpx;
}
.phase-flow-item {
  display: flex;
  gap: 20rpx;
  padding-bottom: 24rpx;
  position: relative;
}
.phase-flow-item:last-child { padding-bottom: 0; }
.phase-flow-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #E0E0E0;
  color: #999;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 2;
}
.phase-flow-dot.done { background: #2E8B57; color: #fff; }
.phase-flow-dot.current {
  background: #E74C3C;
  color: #fff;
  animation: pulse 1.5s infinite;
}
.phase-flow-body { flex: 1; padding-top: 6rpx; }
.phase-flow-name { font-size: 28rpx; color: #999; margin-bottom: 4rpx; }
.phase-flow-name.active { color: #333; font-weight: 600; }
.phase-flow-status { font-size: 22rpx; }

/* 部门任务卡片 */
.dept-task-card {
  background: #F9FAFB;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.dept-task-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}
.dept-task-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.dept-task-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 8rpx;
}
.dept-task-time {
  font-size: 22rpx;
  color: #999;
}
.dept-task-actions {
  margin-top: 12rpx;
}
.mini-btn {
  display: inline-block;
  padding: 12rpx 32rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #E74C3C;
  background: #fff;
  border: 2rpx solid #E74C3C;
  line-height: 1.5;
}
.mini-btn.primary {
  color: #fff;
  background: #E74C3C;
}
.mini-btn.danger {
  color: #E74C3C;
  background: #fff;
  border-color: #E74C3C;
}

.admin-actions-bar {
  display: flex;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}
.admin-actions-bar .mini-btn {
  flex: 1;
  text-align: center;
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #E74C3C 0%, #C0392B 100%);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  font-weight: 500;
}
.btn-primary::after { border: none; }

.btn-secondary {
  background: #F5F5F5;
  color: #666;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
}
.btn-secondary::after { border: none; }
