/* pages/production/production.wxss */
.production-summary { background: linear-gradient(135deg, #E98952, #C75B37); }
.filter-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.filter-label { color: #666; font-size: 27rpx; }
.filter-switch { display: flex; padding: 4rpx; background: #E8EDF5; border: 2rpx solid #D9DEE7; border-radius: 8rpx; }
.filter-option { padding: 14rpx 18rpx; color: #667085; font-size: 26rpx; border-radius: 6rpx; }
.filter-option.active { color: #A54B2D; background: #fff; font-weight: 600; }
.tab-bar { display: flex; background: #fff; border: 2rpx solid #E5E9F0; border-radius: 12rpx; margin-bottom: 24rpx; overflow: hidden; box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06); }
.tab-item { flex: 1; text-align: center; padding: 24rpx 0; font-size: 27rpx; color: #666; }
.tab-item.active { color: #C75B37; font-weight: 600; background: #FFF1EC; }
.create-card { padding: 30rpx; }
.form-row { display: flex; gap: 18rpx; }
.form-group { margin-bottom: 24rpx; }
.form-group.half { flex: 1; min-width: 0; }
.form-label { display: block; font-size: 28rpx; color: #666; margin-bottom: 12rpx; }
.form-input, .form-textarea, .form-picker { width: 100%; background: #F5F6FA; border: 2rpx solid #D9DEE7; border-radius: 8rpx; padding: 22rpx 24rpx; font-size: 30rpx; color: #333; box-sizing: border-box; }
.form-textarea { min-height: 120rpx; }
.form-picker { display: flex; justify-content: space-between; align-items: center; }
.form-hint { padding: 18rpx 20rpx; margin-bottom: 24rpx; color: #9A5A2A; background: #FFF8E8; border: 2rpx solid #F1D9A6; border-radius: 8rpx; font-size: 25rpx; line-height: 1.5; }
.handoff-card { padding: 28rpx; }
.focused-handoff { border: 2rpx solid #C75B37; box-shadow: 0 0 0 6rpx #FFF1EC; }
.reminder-prompt { border-left: 6rpx solid #C75B37; }
.reminder-prompt-title { color: #A54B2D; font-size: 30rpx; font-weight: 600; }
.reminder-prompt-text { margin-top: 10rpx; color: #765E52; font-size: 25rpx; }
.reminder-prompt-actions { display: flex; gap: 16rpx; margin-top: 22rpx; }
.reminder-prompt-actions button { flex: 1; font-size: 26rpx; }
.reminder-skip { color: #C75B37; background: #fff; border: 2rpx solid #C75B37; }
.reminder-confirm { color: #fff; background: #C75B37; border: none; }
.handoff-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 20rpx; margin-bottom: 20rpx; }
.handoff-title { font-size: 34rpx; font-weight: 700; color: #333; line-height: 1.4; }
.handoff-meta { margin-top: 8rpx; color: #999; font-size: 24rpx; }
.status { flex-shrink: 0; padding: 10rpx 14rpx; border: 2rpx solid #D9DEE7; border-radius: 8rpx; font-size: 24rpx; color: #666; background: #F0F0F0; }
.status-submitted { color: #C75B37; background: #FFF1EC; }
.status-assigned { color: #B7791F; background: #FFF7E6; }
.status-archive_assigned { color: #A54B2D; background: #FFF1EC; }
.status-archived { color: #2E8B57; background: #EAF7EF; }
.urgent-tag { display: inline-block; padding: 8rpx 14rpx; margin-bottom: 14rpx; color: #D64545; background: #FFF0F0; border: 2rpx solid #F1CACA; border-radius: 6rpx; font-size: 24rpx; }
.deadline-bar { display: flex; align-items: center; gap: 10rpx; padding: 16rpx 20rpx; margin-bottom: 16rpx; background: #FFF8E1; border-radius: 10rpx; border-left: 6rpx solid #FF9800; }
.deadline-icon { font-size: 28rpx; }
.deadline-text { flex: 1; font-size: 26rpx; font-weight: 600; color: #B7791F; }
.deadline-text.deadline-urgent { color: #E74C3C; }
.deadline-date { font-size: 22rpx; color: #999; }
.handoff-section { margin-top: 16rpx; }
.section-label { color: #999; font-size: 24rpx; margin-bottom: 8rpx; }
.section-text { color: #444; font-size: 28rpx; line-height: 1.6; white-space: pre-wrap; }
.handoff-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.mini-btn { flex: 1; padding: 18rpx 0; border-radius: 8rpx; color: #C75B37; background: #fff; border: 2rpx solid #C75B37; font-size: 26rpx; }
.mini-btn.primary { color: #fff; background: #C75B37; }
.flow-card { padding: 30rpx; }
.flow-step { display: flex; gap: 20rpx; padding-bottom: 30rpx; }
.flow-step:last-child { padding-bottom: 0; }
.step-index { width: 52rpx; height: 52rpx; line-height: 52rpx; text-align: center; border-radius: 50%; color: #fff; background: #C75B37; font-size: 26rpx; font-weight: 700; flex-shrink: 0; }
.step-title { font-size: 32rpx; font-weight: 600; color: #333; margin-bottom: 8rpx; }
.step-text { font-size: 27rpx; color: #666; line-height: 1.6; }
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.5); z-index: 1000; display: flex; align-items: center; justify-content: center; }
.modal-content { width: 86%; max-height: 88%; overflow-y: auto; background: #fff; border: 2rpx solid #E5E9F0; border-radius: 12rpx; padding: 40rpx; }
.modal-title { font-size: 34rpx; font-weight: 600; text-align: center; margin-bottom: 30rpx; color: #333; }
.picker-value { display: flex; justify-content: space-between; align-items: center; background: #F5F6FA; border: 2rpx solid #D9DEE7; border-radius: 8rpx; padding: 22rpx 24rpx; font-size: 30rpx; }
.modal-actions { display: flex; gap: 20rpx; margin-top: 30rpx; }
.modal-actions .btn-secondary, .modal-actions .modal-confirm { flex: 1; }
