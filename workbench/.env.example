HOST=127.0.0.1
PORT=3001
DATA_DIR=.data
# 本机开发留空，使用 .data/postgres；生产必须显式走 CloudBase HTTPS。
DATABASE_URL=
# 生产变量由 deployment/deploy-cloudbase.mjs 安全注入，不写进前端：
# DATABASE_PROVIDER=cloudbase-http
# CLOUDBASE_ENV_ID=tccc-qncmzx-d0gxalbv77f0dae9f
# CLOUDBASE_APIKEY=<dedicated-server-key>
# JOB_TRIGGER_TOKEN=<independent-random-secret>
# APP_ORIGIN=https://your-workbench.example
# VITE_HIDE_DEMO=true
# NOTIFICATION_ENDPOINT=https://your-approved-notification-relay.example
# NOTIFICATION_TOKEN=...
